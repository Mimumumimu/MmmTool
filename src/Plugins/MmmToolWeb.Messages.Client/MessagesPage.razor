@attribute [Route(Route)]
@implements IAsyncDisposable
@inject MessagesClient Messages
@inject BrowserClient Browser
@inject NavigationManager Navigation

<div class="screen">
    <FeatureHeader Title="メッセージ" Busy="@(_loading || _sending)">
        <button type="button" class="text strong" @onclick="SendAsync" disabled="@(!CanSend)">送信</button>
    </FeatureHeader>

    @if (_result is not null)
    {
        <p class="@(_resultIsError ? "result error" : "result")" role="@(_resultIsError ? "alert" : "status")">@_result</p>
    }

    @if (_loaded && _recipients.Count == 0)
    {
        <p class="result" role="status">送信先がありません。MmmTool の設定ページの「送信先」で登録してください。</p>
    }

    <div class="form">
        <label class="field">
            <span>宛先</span>
            <select @bind="_channelId" disabled="@(_recipients.Count == 0)">
                @foreach (var recipient in _recipients)
                {
                    <option value="@recipient.ChannelId">@recipient.DisplayName</option>
                }
            </select>
        </label>

        <label class="field">
            <span>タイトル</span>
            <input type="text" maxlength="@_titleMaxLength" placeholder="省略できます" autocomplete="off" @bind="_title" @bind:event="oninput" />
        </label>

        <label class="field grow">
            <span>本文</span>
            <textarea @ref="_bodyInput" maxlength="@_bodyMaxLength" @bind="_body" @bind:event="oninput" @onfocus="OnBodyFocusAsync"></textarea>
        </label>
    </div>
</div>

@code {
    /// <summary>メッセージの画面の道。</summary>
    public const string Route = "/messages";

    /// <summary>前回送った宛先を覚える、この端末の値の名前。</summary>
    private const string LastChannelKey = "messages.lastChannelId";

    private IReadOnlyList<MessageRecipientDto> _recipients = [];
    private bool _loaded;
    private bool _loading;
    private bool _sending;
    private bool _watching;
    private int _channelId;
    private string _title = "";
    private string _body = "";
    private string _signature = "";
    private int _titleMaxLength = 100;
    private int _bodyMaxLength = 1000;
    private string? _result;
    private bool _resultIsError;
    private ElementReference _bodyInput;

    /// <summary>送れる状態か。サーバーも同じ決まり (署名以外の本文があること)で確かめる。</summary>
    private bool CanSend => !_sending && _channelId != 0 && !string.IsNullOrWhiteSpace(_body) && _body.Trim() != _signature.Trim();

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_watching)
        {
            _watching = true;
            Browser.BecameVisible += LoadOnReturnAsync;
            await Browser.StartWatchingVisibilityAsync();
        }
    }

    /// <summary>アプリが裏から戻ったときに、宛先を読み直す。書きかけの内容は残す。</summary>
    private Task LoadOnReturnAsync() => InvokeAsync(LoadAsync);

    /// <summary>
    /// 宛先と署名を読む。選んでいる宛先、なければ前回送った宛先、それも無ければ先頭を選ぶ。
    /// </summary>
    private async Task LoadAsync()
    {
        _loading = true;
        // 裏から戻ったときの読み直しでも、進行バーが出るように、待つ前に画面へ反映する
        StateHasChanged();
        var result = await Messages.LoadFormAsync();
        _loading = false;
        if (result.Status == ApiFailure.SignedOut)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }
        if (!result.Succeeded)
        {
            ShowResult($"宛先を読み込めませんでした: {result.Message}", isError: true);
            StateHasChanged();
            return;
        }

        var form = result.Value!;
        _recipients = form.Recipients;
        _signature = form.Signature;
        _titleMaxLength = form.TitleMaxLength;
        _bodyMaxLength = form.BodyMaxLength;

        // 書きかけの本文は上書きしない
        if (_body.Length == 0)
        {
            _body = _signature;
        }

        var wanted = _channelId;
        if (wanted == 0 && int.TryParse(await Browser.GetRememberedAsync(LastChannelKey), out var remembered))
        {
            wanted = remembered;
        }
        _channelId = _recipients.FirstOrDefault(r => r.ChannelId == wanted)?.ChannelId ?? _recipients.FirstOrDefault()?.ChannelId ?? 0;
        _loaded = true;
        StateHasChanged();
    }

    /// <summary>本文が署名だけのとき、カーソルを先頭に置く。署名の後ろから書き始めないため。</summary>
    private Task OnBodyFocusAsync()
        => _body == _signature ? Browser.PlaceCaretAtStartAsync(_bodyInput) : Task.CompletedTask;

    /// <summary>送信を依頼する。依頼の行が書かれるだけで、実際に送るのは MmmBatch。</summary>
    private async Task SendAsync()
    {
        // 押した直後は、ボタンが押せない表示に変わる前なので、続けて押された分はここで止める (2 通送らないため)
        if (!CanSend)
        {
            return;
        }

        var recipient = _recipients.First(r => r.ChannelId == _channelId);
        _sending = true;
        _result = null;
        // 進行バーを出すため、待つ前に画面へ反映する
        StateHasChanged();
        var result = await Messages.SendAsync(new MessageSendRequestDto(_channelId, _title.Trim(), _body.Trim()));
        _sending = false;

        if (result.Status == ApiFailure.SignedOut)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }
        if (!result.Succeeded)
        {
            // 選んだあとに送信先が消えたときは、宛先を読み直して選び直してもらう
            if (result.Status == ApiFailure.NotFound)
            {
                await LoadAsync();
            }
            ShowResult($"送信を依頼できませんでした: {result.Message}", isError: true);
            return;
        }

        // タイトルと宛先は残し、本文を署名だけに戻す
        _body = _signature;
        ShowResult($"{recipient.DisplayName} に送信を依頼しました", isError: false);
        await Browser.RememberAsync(LastChannelKey, _channelId.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    private void ShowResult(string message, bool isError)
    {
        _result = message;
        _resultIsError = isError;
    }

    public ValueTask DisposeAsync()
    {
        Browser.BecameVisible -= LoadOnReturnAsync;
        return ValueTask.CompletedTask;
    }
}
