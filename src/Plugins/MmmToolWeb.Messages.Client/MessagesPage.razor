@attribute [Route(Route)]
@implements IAsyncDisposable
@inject MessageStore Store
@inject MessagesClient Messages
@inject BrowserClient Browser
@inject NavigationManager Navigation

<div class="screen">
    <FeatureHeader Title="メッセージ" Busy="@_loading" />

    @if (_error is not null)
    {
        <p class="result error" role="alert">@_error</p>
    }

    @if (_loaded && Store.Conversations.Count == 0)
    {
        <p class="empty">会話はまだありません。「新しい会話」から宛先を選んでください。</p>
    }

    @if (Store.Conversations.Count > 0)
    {
        <ul class="list first" aria-label="会話">
            @foreach (var conversation in Store.Conversations)
            {
                <li>
                    <a class="row" href="@ConversationPath(conversation)">
                        <span class="line">
                            <span class="who">
                                @if (Store.IsUnread(conversation))
                                {
                                    <span class="dot" role="img" aria-label="未読"></span>
                                }
                                <span class="@(Store.IsUnread(conversation) ? "name unread" : "name")">@conversation.Name</span>
                            </span>
                            <span class="time">@conversation.TimeText</span>
                        </span>
                        <span class="preview">@conversation.LastText</span>
                        @if (!conversation.PeerCanReceive)
                        {
                            <span class="note">受け取り先が未設定</span>
                        }
                    </a>
                </li>
            }
        </ul>
    }

    <button type="button" class="fab" @onclick="PickPersonAsync">新しい会話</button>
</div>

@if (_picking)
{
    <div class="sheet" role="dialog" aria-label="宛先を選ぶ">
        <div class="screen">
            <FeatureHeader Title="宛先を選ぶ" Busy="@(!_peopleLoaded)" BackText="キャンセル" BackMark="" OnBack="CancelPick" />

            @if (_peopleLoaded && _people.Count == 0)
            {
                <p class="empty">宛先にできる人がいません。</p>
            }

            <ul class="list first" aria-label="宛先に選べる人">
                @foreach (var person in _people)
                {
                    <li>
                        <button type="button" class="row" @onclick="() => OpenPersonAsync(person)">
                            <span class="name">@person.DisplayName</span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    /// <summary>メッセージの会話の一覧の画面の道。</summary>
    public const string Route = "/messages";

    private IAsyncDisposable? _live;
    private bool _watching;
    private bool _loading;
    private bool _loaded;
    private string? _error;
    private bool _picking;
    private bool _peopleLoaded;
    private bool _opening;
    private IReadOnlyList<PersonDto> _people = [];

    protected override async Task OnInitializedAsync()
    {
        Store.ConversationsChanged += OnConversationsChangedAsync;
        await LoadAsync();
        _live = await Store.AcquireLiveAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_watching)
        {
            _watching = true;
            Browser.BecameVisible += LoadOnReturnAsync;
            await Browser.StartWatchingVisibilityAsync();
        }
    }

    /// <summary>会話の画面の道を作る。</summary>
    /// <param name="conversation">会話。</param>
    /// <returns>会話の画面の道。</returns>
    private static string ConversationPath(ConversationDto conversation) => $"messages/{conversation.Id}";

    /// <summary>アプリが裏から戻ったときに、読み直す。</summary>
    private Task LoadOnReturnAsync() => InvokeAsync(LoadAsync);

    /// <summary>会話の一覧が変わったとき、画面を直す。</summary>
    private Task OnConversationsChangedAsync() => InvokeAsync(StateHasChanged);

    /// <summary>会話の一覧を読み込む。まず控えから出し、サーバーから読み直す。</summary>
    private async Task LoadAsync()
    {
        _loading = true;
        // 裏から戻ったときの読み直しでも、進行バーが出るように、待つ前に画面へ反映する
        StateHasChanged();
        var result = await Store.LoadAsync();
        _loading = false;
        if (result.Status == ApiFailure.SignedOut)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        _loaded = true;
        _error = result.Succeeded ? null : $"会話を読み込めませんでした: {result.Message}";
        StateHasChanged();
    }

    /// <summary>宛先を選ぶ画面を開く。宛先に選べる人を、開くたびに読み直す。</summary>
    private async Task PickPersonAsync()
    {
        _picking = true;
        _peopleLoaded = false;
        _people = [];
        StateHasChanged();

        var result = await Messages.SearchPeopleAsync("");
        if (result.Status == ApiFailure.SignedOut)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }
        if (!_picking)
        {
            return;
        }

        _people = result.Succeeded ? result.Value! : [];
        _peopleLoaded = result.Succeeded;

        // 成功では、エラーを消さない。会話の読み込みの失敗を、消さないため
        if (!result.Succeeded)
        {
            _error = $"宛先の人を読み込めませんでした: {result.Message}";
            _picking = false;
        }
    }

    /// <summary>宛先を選ぶ画面を閉じる。</summary>
    private void CancelPick()
    {
        _picking = false;
        _people = [];
    }

    /// <summary>選んだ人との会話を開く。まだ会話が無いときは、空の会話の画面を出す。会話は、最初の送信で作る。</summary>
    /// <param name="person">選んだ人。</param>
    private async Task OpenPersonAsync(PersonDto person)
    {
        // 続けて押されても、2 回開かない
        if (_opening)
        {
            return;
        }

        _opening = true;
        try
        {
            var result = await Messages.FindDirectAsync(person.UserId);
            if (result.Status == ApiFailure.SignedOut)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }
            if (!result.Succeeded)
            {
                _error = $"会話を開けませんでした: {result.Message}";
                _picking = false;
                return;
            }

            Navigation.NavigateTo(result.Value!.ConversationId > 0
                ? $"messages/{result.Value.ConversationId}"
                : $"messages/new/{person.UserId}?name={Uri.EscapeDataString(person.DisplayName)}");
        }
        finally
        {
            _opening = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Store.ConversationsChanged -= OnConversationsChangedAsync;
        Browser.BecameVisible -= LoadOnReturnAsync;
        if (_live is not null)
        {
            await _live.DisposeAsync();
        }
    }
}
