@page "/home"
@inject IEnumerable<ClientFeature> Features
@inject FeatureAvailability Availability
@inject SessionClient Session
@inject BrowserClient Browser
@inject IEnumerable<IUnreadCountSource> Sources
@implements IDisposable

<main class="home">
    <div class="top">
        <h1>ホーム</h1>
        <a class="settings" href="settings" aria-label="設定">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@SettingsIconPath" /></svg>
        </a>
    </div>

    @if (_available.Count > 0)
    {
        <nav class="features" aria-label="機能">
            @foreach (var feature in _available)
            {
                <a class="row" href="@feature.Route">
                    <span class="badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@feature.IconPath" /></svg></span>
                    <span class="name">@feature.Title</span>
                    @if (UnreadCount(feature) is > 0 and var unread)
                    {
                        <span class="count" role="img" aria-label="未読 @unread 件">@(unread > MaxShownCount ? $"{MaxShownCount}+" : unread.ToString())</span>
                    }
                    <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="@ChevronPath" /></svg>
                </a>
            }
        </nav>
    }

    <button type="button" class="logout" @onclick="Session.LogoutAsync">ログアウト</button>
</main>

@code {
    /// <summary>ホームに出す機能。管理者に使えなくされた機能は含まない。読み込むまでは空。</summary>
    private IReadOnlyList<ClientFeature> _available = [];

    /// <summary>前に聞いた結果があれば、先にタイルに出す。開くたびに、空のタイルを挟まないため。</summary>
    protected override void OnInitialized() => _available = Availability.FilterRemembered(Features) ?? [];

    /// <summary>使える機能を、サーバーに聞き直して、タイルに出す。</summary>
    /// <returns>読み込みの完了を表すタスク。</returns>
    protected override async Task OnInitializedAsync()
    {
        await LoadUnreadAsync();
        StateHasChanged();
        _available = await Availability.FilterAsync(Features);
    }

    /// <summary>画面を出した最初だけ、前面への復帰を見張り始める。</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Browser.BecameVisible += LoadUnreadOnReturnAsync;
            await Browser.StartWatchingVisibilityAsync();
        }
    }

    /// <summary>端末が覚えている、読んでいない通知の識別子「種類:番号」。</summary>
    private IReadOnlyList<string> _unreadKeys = [];

    /// <summary>サーバーに聞いた、種類ごとの読んでいない数。サーバーが数える種類だけ。</summary>
    private readonly Dictionary<string, int> _serverCounts = [];

    /// <summary>行に出す数の上限。これを超えたら「99+」のように出す。</summary>
    private const int MaxShownCount = 99;

    /// <summary>機能の、読んでいない通知の数。数を出さない機能は 0。サーバーが数える種類は、サーバーに聞いた数。</summary>
    private int UnreadCount(ClientFeature feature)
        => feature.UnreadKind is not { } kind
            ? 0
            : Sources.Any(source => source.Kind == kind)
                ? _serverCounts.GetValueOrDefault(kind)
                : _unreadKeys.Count(key => key.StartsWith(kind + ":", StringComparison.Ordinal));

    /// <summary>端末の控えの一覧と、サーバーが数える種類の数を読む。数を聞けなかった種類は、前の数のまま。聞けたら、アイコンの数字も直す。</summary>
    private async Task LoadUnreadAsync()
    {
        _unreadKeys = await Browser.GetUnreadAsync();
        foreach (var source in Sources)
        {
            if (await source.GetCountAsync() is { } count)
            {
                _serverCounts[source.Kind] = count;
                await Browser.SetServerUnreadAsync(source.Kind, count);
            }
        }
    }

    /// <summary>アプリが裏から戻ったときに、数を読み直す。</summary>
    private Task LoadUnreadOnReturnAsync() => InvokeAsync(async () =>
    {
        await LoadUnreadAsync();
        StateHasChanged();
    });

    public void Dispose() => Browser.BecameVisible -= LoadUnreadOnReturnAsync;

    /// <summary>行の右端の「›」の形。24 × 24 の枠の SVG の path で、線で描く。</summary>
    private const string ChevronPath = "M9.5 6l6 6-6 6";

    /// <summary>設定の歯車のアイコンの形。24 × 24 の枠の SVG の path。</summary>
    private const string SettingsIconPath =
        "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
}
