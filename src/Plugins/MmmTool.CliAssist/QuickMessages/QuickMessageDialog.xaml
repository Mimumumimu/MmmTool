<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MmmTool.CliAssist.QuickMessages.QuickMessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.CliAssist.QuickMessages"
    Title="よく使う文の編集"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonText="保存"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- ContentDialog の幅の上限 (ContentDialogMaxWidth = 548)に収まる幅 -->
    <Grid Width="500" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="300" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 一覧 (ドラッグで並べ替えと、グループへの出し入れ) + 追加・削除 -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <!-- 文は子を持てないので、その上へは落とせない。AllowDrop はグループの行だけで、グループをドラッグしている間は、コードビハインドが外す。グループの中の文の間へ落ちたときは、ViewModel が外へ出す -->
                    <TreeView
                        x:Name="Tree"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsStarting="OnTreeDragItemsStarting"
                        ItemsSource="{x:Bind ViewModel.RootItems}"
                        SelectionChanged="OnTreeSelectionChanged"
                        SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:QuickMessageEditItem">
                                <TreeViewItem
                                    AllowDrop="{x:Bind IsGroup}"
                                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind Children}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock
                        Margin="4,8"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Text="よく使う文はありません。「文を追加」で作成します"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay}" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.AddMessageCommand}" Content="文を追加" />
                    <Button Command="{x:Bind ViewModel.AddGroupCommand}" Content="グループを追加" />
                    <Button Command="{x:Bind ViewModel.RemoveCommand}" Content="削除" />
                </StackPanel>
            </Grid>

            <!-- 選んだ項目の編集 -->
            <StackPanel
                Grid.Column="1"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsGroupSelected, Mode=OneWay}">
                <TextBox
                    x:Name="GroupNameBox"
                    Header="グループ名"
                    Text="{x:Bind ViewModel.SelectedItem.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsMessageSelected, Mode=OneWay}">
                <TextBox
                    Header="表示名 (省略可)"
                    PlaceholderText="省略すると、文の 1 行目"
                    Text="{x:Bind ViewModel.SelectedItem.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                <TextBox
                    x:Name="MessageTextBox"
                    Height="180"
                    AcceptsReturn="True"
                    Header="文"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.SelectedItem.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />
    </Grid>
</ContentDialog>
