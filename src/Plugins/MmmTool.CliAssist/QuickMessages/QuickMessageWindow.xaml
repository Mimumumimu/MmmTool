<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.CliAssist.QuickMessages.QuickMessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.CliAssist.QuickMessages"
    Title="よく使う文の編集">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- 行を右クリックしたときのメニュー。何も無い所では出さない。追加は左下のボタンと同じ動きで、削除は確認の吹き出しを、右クリックした行のそばに出す -->
            <MenuFlyout x:Name="RowMenu">
                <MenuFlyoutItem Command="{x:Bind ViewModel.AddMessageCommand}" Text="文を追加">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Command="{x:Bind ViewModel.AddGroupCommand}" Text="グループを追加">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Click="OnRowMenuRemoveClick" Text="削除">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯は、ドラッグで移動できる。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="よく使う文の編集" />
        </Grid>

        <!-- 左: 一覧 (ドラッグで並べ替えと、グループへの出し入れ) + 追加・削除 / 右: 選んだ項目の編集。ウィンドウの大きさに合わせて伸びる -->
        <Grid
            Grid.Row="1"
            Padding="24,16,24,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="264" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <!-- 文は子を持てないので、その上へは落とせない。AllowDrop はグループの行だけで、グループをドラッグしている間は、コードビハインドが外す。グループの中の文の間へ落ちたときは、ViewModel が外へ出す -->
                    <TreeView
                        x:Name="Tree"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsStarting="OnTreeDragItemsStarting"
                        ItemsSource="{x:Bind ViewModel.RootItems}"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        SelectionChanged="OnTreeSelectionChanged"
                        SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:QuickMessageEditItem">
                                <TreeViewItem
                                    AllowDrop="{x:Bind IsGroup}"
                                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind Children}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock
                        Margin="4,8"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Text="よく使う文はありません。「文を追加」で作成します"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay}" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.AddMessageCommand}" Content="文を追加" />
                    <Button Command="{x:Bind ViewModel.AddGroupCommand}" Content="グループを追加" />
                    <!-- 中に文があるグループだけ、削除の前に確認の吹き出しを出す -->
                    <Button
                        x:Name="RemoveButton"
                        Click="OnRemoveClick"
                        Content="削除"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="RemoveConfirmFlyout" Placement="Top">
                                <StackPanel Width="260" Spacing="12">
                                    <TextBlock
                                        x:Name="RemoveConfirmTitle"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock x:Name="RemoveConfirmBody" TextWrapping="Wrap" />
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button Click="OnRemoveConfirmed" Content="削除" />
                                        <Button Click="OnRemoveCanceled" Content="キャンセル" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 選んだ項目の編集。文の入力欄は、残りの高さいっぱいに伸びる -->
            <StackPanel
                Grid.Column="1"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsGroupSelected, Mode=OneWay}">
                <TextBox
                    x:Name="GroupNameBox"
                    Header="グループ名"
                    Text="{x:Bind ViewModel.SelectedItem.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
            </StackPanel>
            <Grid
                Grid.Column="1"
                RowSpacing="12"
                Visibility="{x:Bind ViewModel.IsMessageSelected, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox
                    Header="表示名 (省略可)"
                    PlaceholderText="省略すると、文の 1 行目"
                    Text="{x:Bind ViewModel.SelectedItem.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                <TextBox
                    x:Name="MessageTextBox"
                    Grid.Row="1"
                    VerticalAlignment="Stretch"
                    AcceptsReturn="True"
                    Header="文"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    Text="{x:Bind ViewModel.SelectedItem.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>

        <!-- 下: エラー (左)と、操作ボタン。肯定を左・キャンセルを右に (Windows の流儀) -->
        <Grid
            Grid.Row="2"
            Padding="24,16,24,24"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="96"
                    Click="OnSaveClick"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    MinWidth="96"
                    Click="OnCancelClick"
                    Content="キャンセル" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
