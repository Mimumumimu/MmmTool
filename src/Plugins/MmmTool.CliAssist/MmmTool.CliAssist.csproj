<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ターミナルの定型コマンドから呼ぶ補助スクリプト ({AppDir}\Assets\Tools\...)。参照するアプリの出力フォルダー (Assets\Tools)へコピーする。
      WinUI のライブラリの Content や Assets フォルダーの中身は、コピー先にプロジェクト名のフォルダーが付くため、Assets の外に置き、None で指定する (既定で None に含まれるので Update。SDK のターミナルの資材と同じ形)
    -->
    <None Update="Tools\*" Link="Assets\Tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MmmTool.CliAssist.Core\MmmTool.CliAssist.Core.csproj" />
    <ProjectReference Include="..\..\..\external\MmmSdk\MmmSdk.WinUI\MmmSdk.WinUI.csproj" />
  </ItemGroup>

</Project>
