<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MmmTool.CliAssist.FocusTriggers.FocusTriggerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.CliAssist.FocusTriggers"
    Title="通知する文字列の編集"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonText="保存"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- ContentDialog の幅の上限 (ContentDialogMaxWidth = 548)に収まる幅 -->
    <Grid Width="500" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="ターミナルにこの文字列が出たとき、タブとサイドバーで知らせます。空白と大文字小文字は区別しません。"
            TextWrapping="Wrap" />

        <!-- 項目の数が変わっても、ダイアログの大きさは変えない。高さを固定した枠の中でスクロールする -->
        <Grid Grid.Row="1" Height="200">
            <ScrollViewer x:Name="TriggerScroll" VerticalScrollBarVisibility="Visible">
                <!-- スクロールバーは中身の上に重なって出るので、右に余白を取って「削除」を隠さない -->
                <ItemsControl
                    x:Name="TriggerList"
                    Margin="0,0,16,0"
                    ItemsSource="{x:Bind ViewModel.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:FocusTriggerEditItem">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.Name="通知する文字列"
                                    PlaceholderText="例: Do you want to proceed?"
                                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <!-- 既定でオン。オフの文字列は、タブとサイドバーで知らせるだけで、フォーカスは移さない -->
                                <CheckBox
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    Content="ターミナルへ移る"
                                    IsChecked="{x:Bind MoveToTerminal, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{x:Bind RemoveCommand}"
                                    Content="削除" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                Margin="4,8"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="文字列はありません。「追加」で作成します"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay}" />
        </Grid>

        <Button
            Grid.Row="2"
            Command="{x:Bind ViewModel.AddCommand}"
            Content="追加" />

        <TextBlock
            Grid.Row="3"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />
    </Grid>
</ContentDialog>
