<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.CliAssist.Main.QuickMessageBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.CliAssist.Main"
    xmlns:sdkControls="using:MmmSdk.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 控えめな見た目。枠だけで押せることを示し、マウスを乗せたときだけ薄く塗る。編集ボタン・チップ・「⋯」で共有する -->
            <!-- 色はテーマごとの辞書に直接書く (StaticResource の別名は読み込み時のテーマで固定され、テーマを切り替えても追従しない) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C5FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#09000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#06000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#66000000" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#9E000000" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E4000000" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#9E000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 文のチップ。押すと文が入力欄に入る -->
            <DataTemplate x:Key="MessageTemplate" x:DataType="local:QuickMessageItem">
                <Button
                    Height="22"
                    MaxWidth="240"
                    Padding="10,0"
                    AutomationProperties.Name="{x:Bind Text}"
                    Click="OnChipClick"
                    CornerRadius="12"
                    FontSize="12"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind Text}">
                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                </Button>
            </DataTemplate>

            <!-- グループのチップ。押すと中の文の一覧が開く -->
            <DataTemplate x:Key="GroupTemplate" x:DataType="local:QuickMessageItem">
                <Button
                    Height="22"
                    MaxWidth="240"
                    Padding="10,0,8,0"
                    AutomationProperties.Name="{x:Bind Label}"
                    CornerRadius="12"
                    FontSize="12"
                    Tag="{x:Bind}">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Glyph="&#xE70D;" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout Opening="OnGroupFlyoutOpening" Placement="TopEdgeAlignedLeft" />
                    </Button.Flyout>
                </Button>
            </DataTemplate>

            <local:QuickMessageTemplateSelector
                x:Key="ChipTemplateSelector"
                GroupTemplate="{StaticResource GroupTemplate}"
                MessageTemplate="{StaticResource MessageTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- よく使う文の編集。先頭に固定し、文が 0 件でも出す -->
        <Button
            Width="32"
            Height="22"
            Padding="0"
            AutomationProperties.Name="よく使う文を編集"
            Command="{x:Bind EditCommand, Mode=OneWay}"
            CornerRadius="12"
            ToolTipService.ToolTip="よく使う文を編集">
            <FontIcon FontSize="12" Glyph="&#xE70F;" />
        </Button>

        <!-- チップは幅に収まる分だけ並べ、収まらない分は右端の「⋯」の一覧に出す。背景を持たないので、チップの間のクリックは入力欄へ届く -->
        <Grid Grid.Column="1">
            <ItemsRepeater
                x:Name="Chips"
                ItemTemplate="{StaticResource ChipTemplateSelector}"
                ItemsSource="{x:Bind Messages, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <sdkControls:OverflowRowLayout x:Name="ChipsLayout" ReservedWidth="38" Spacing="6" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
            <Button
                x:Name="OverflowButton"
                Width="32"
                Height="22"
                Padding="0"
                HorizontalAlignment="Right"
                AutomationProperties.Name="その他のよく使う文"
                CornerRadius="12"
                ToolTipService.ToolTip="その他のよく使う文"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Opening="OnOverflowFlyoutOpening" Placement="TopEdgeAlignedRight" />
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
