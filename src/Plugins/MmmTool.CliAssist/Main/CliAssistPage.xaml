<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.CliAssist.Main.CliAssistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.CliAssist.Main"
    Loaded="OnLoaded">

    <Grid Padding="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左ペイン: 定型コマンド -->
        <Border
            Padding="4,4,4,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="CategorySelector" SelectionChanged="OnCategorySelectionChanged">
                        <SelectorBarItem
                            x:Name="ShellCategoryItem"
                            IsSelected="True"
                            Text="シェル" />
                        <SelectorBarItem x:Name="SessionCategoryItem" Text="AI セッション" />
                    </SelectorBar>
                    <!-- その他の操作。めったに使わない・取り消せない操作は、常に見えるボタンにせず、ここに入れる -->
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="その他"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="その他">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <!-- 定型コマンドを既定の内容に作り直す (環境の選び直しを含む)。確認してから行う -->
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ResetCommandsCommand}" Text="定型コマンドを初期化…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <TreeView
                    x:Name="CommandTree"
                    Grid.Row="1"
                    ItemInvoked="OnCommandTreeItemInvoked"
                    Loaded="OnCommandTreeLoaded"
                    SelectionMode="None">
                    <!-- ノードはコードビハインドで作る。最初はすべて開いた状態 (閉じるのは自由) -->
                    <TreeView.ItemTemplate>
                        <!-- 手作りのノードでは、行に渡されるデータはノード自身。中身 (Content)が CommandTreeItem -->
                        <DataTemplate x:DataType="TreeViewNode">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                ToolTipService.ToolTip="{x:Bind ((local:CommandTreeItem)Content).ToolTip}">
                                <FontIcon FontSize="14" Glyph="{x:Bind ((local:CommandTreeItem)Content).Glyph}" />
                                <TextBlock Text="{x:Bind ((local:CommandTreeItem)Content).Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!--
            右: セッション (1 タブ = ターミナルと送信欄)。タブはコードビハインドで作る (ViewModel のセッションの一覧に合わせる)。
            TabView は、タブの帯だけに使う。中身は、選んだタブの画面を下の枠に入れる
            (TabView の中身の枠は、内容の大きさのまま左上に寄せて表示するため、ターミナルが大きさを持てない)。
            タブの操作はマウスだけ。並べ替え・ドラッグはしない
        -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabView
                x:Name="SessionTabs"
                AddTabButtonClick="OnAddTabButtonClick"
                CanDragTabs="False"
                CanReorderTabs="False"
                SelectionChanged="OnSessionTabSelectionChanged"
                TabCloseRequested="OnTabCloseRequested">
                <!--
                    選択中のタブの枠線は、既定では薄いグラデーションで、背景と見分けにくい。
                    枠線だけを、少し濃い色 (システムの「第 2 の枠線」。「強い枠線」は濃すぎた)にする。背景の色は既定のまま。
                    ハイコントラストは、システムの配色に任せる (書かない)
                -->
                <TabView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="TabViewSelectedItemBorderBrush" ResourceKey="ControlStrokeColorSecondaryBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="TabViewSelectedItemBorderBrush" ResourceKey="ControlStrokeColorSecondaryBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TabView.Resources>
            </TabView>
            <Border x:Name="SessionHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
