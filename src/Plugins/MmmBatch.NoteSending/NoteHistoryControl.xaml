<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmBatch.NoteSending.NoteHistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:connection="using:MmmTool.Data.SqlServer.WinUI.Connection"
    xmlns:sending="using:MmmBatch.Sending">

    <Grid>
        <Grid.Resources>
            <!-- 列の幅は、見出しと行で共通。時刻 / 更新した人 / 宛先 / タイトルは残りの幅 / 結果 -->
            <GridLength x:Key="TimeColumnWidth">160</GridLength>
            <GridLength x:Key="EditorColumnWidth">100</GridLength>
            <GridLength x:Key="RecipientColumnWidth">220</GridLength>
            <GridLength x:Key="ResultColumnWidth">160</GridLength>
        </Grid.Resources>

        <!-- 一覧 (見出しは固定で、行だけスクロール) -->
        <Grid
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 見出し。左右の余白は行 (ListViewItem の外側 4 + 内側 12)に合わせる -->
            <Grid
                Grid.Row="0"
                Padding="16,10,16,10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource TimeColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource EditorColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource RecipientColumnWidth}" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="{StaticResource ResultColumnWidth}" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="時刻" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="更新した人" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="宛先" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="タイトル" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="結果" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>

            <ListView
                Grid.Row="1"
                Padding="0,4"
                ItemsSource="{x:Bind ViewModel.Items}"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="sending:SendHistoryItemViewModel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource TimeColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource EditorColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource RecipientColumnWidth}" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="{StaticResource ResultColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind TimeText}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind SenderName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind RecipientText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind RecipientText}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Text="{x:Bind ResultText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind ResultText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 1 件も無いとき -->
            <TextBlock
                Grid.Row="1"
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="起動してから、送ったものはありません。"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <!-- エラー。レイアウトに場所を取らず、一覧の上部に重ねる -->
            <connection:ConnectionErrorBar
                Grid.Row="1"
                Margin="8,8,8,0"
                VerticalAlignment="Top"
                ViewModel="{x:Bind ViewModel}" />
        </Grid>
    </Grid>
</UserControl>
