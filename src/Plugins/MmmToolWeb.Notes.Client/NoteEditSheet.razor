@inject NotesClient Notes
@inject BrowserClient Browser
@implements IAsyncDisposable

<EditSheet Title="@SheetTitle" CancelDisabled="_saving" ConfirmDisabled="CannotSave" OnCancel="OnCancel" OnConfirm="SaveAsync">
    @if (_error is not null)
    {
        <p class="message" role="alert">@_error</p>
    }

    <label class="form-field">
        <span>タイトル</span>
        <input type="text" maxlength="@NoteLimits.TitleMaxLength" autocomplete="off" @bind="_title" @bind:event="oninput" />
    </label>

    <label class="form-field">
        <span>本文</span>
        <textarea rows="10" @bind="_body" @bind:event="oninput"></textarea>
    </label>

    <div class="dates">
        <div class="form-field">
            <span>開始日</span>
            <DatePicker Label="開始日" Value="_start" Invalid="IsEventOutOfPeriod" OnPicked="OnStartPicked" />
        </div>

        <div class="form-field">
            <span>終了日</span>
            <DatePicker Label="終了日" Value="_end" Invalid="IsEventOutOfPeriod" OnPicked="OnEndPicked" />
            <div class="end-footer">
                <button type="button" class="text" @onclick="OnEndCleared" disabled="@(_end is null)">クリア</button>
            </div>
            @if (_end is null)
            {
                <small class="hint">空のときは無期限です</small>
            }
        </div>
    </div>

    <div class="dates">
        <div class="form-field">
            <span>実施日</span>
            <DatePicker Label="実施日" Value="_eventDate" Invalid="IsEventOutOfPeriod" OnPicked="OnEventPicked" />
            <div class="end-footer">
                <button type="button" class="text" @onclick="OnEventCleared" disabled="@(_eventDate is null)">クリア</button>
            </div>
        </div>
    </div>

    @if (IsEventOutOfPeriod)
    {
        <p class="alert" role="alert">実施日 (@EventText)が期間の外です。開始日・終了日か実施日を直してください。</p>
    }
    else if (_info is not null)
    {
        <p class="info" role="status">@_info</p>
    }

    <fieldset class="form-group">
        <legend>重要度</legend>
        <div class="segments">
            @foreach (var (value, label) in Priorities)
            {
                <label class="segment">
                    <input type="radio" name="priority" checked="@(_priority == value)" @onchange="() => _priority = value" />
                    <span>@label</span>
                </label>
            }
        </div>
    </fieldset>

    @if (Note is null || Note.IsMine)
    {
        <label class="check">
            <input type="checkbox" @bind="_private" />
            <span>自分だけに表示</span>
        </label>
    }
</EditSheet>

@code {
    /// <summary>シートの名前。新規か編集かで変える。</summary>
    private string SheetTitle => Note is null ? "新規ノート" : "ノートの編集";

    /// <summary>保存できないとき true。保存中と、タイトルが空のときと、実施日が期間の外のとき。</summary>
    private bool CannotSave => _saving || string.IsNullOrWhiteSpace(_title) || IsEventOutOfPeriod;

    /// <summary>重要度の選択肢。左が低く、右が高い。</summary>
    private static readonly (int Value, string Label)[] Priorities = [(1, "最低"), (2, "低"), (3, "中"), (4, "高"), (5, "最高")];

    /// <summary>編集するノート。新規のときは null。</summary>
    [Parameter]
    public NoteDto? Note { get; set; }

    /// <summary>新規のときの開始日の初期値。画面が表示している日。</summary>
    [Parameter]
    public DateOnly DefaultStart { get; set; }

    /// <summary>保存できたときに呼ぶ。</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>取りやめたときに呼ぶ。</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>ノートが見つからなかったときに呼ぶ。ほかの人が先に変えた場合などで、理由を渡す。</summary>
    [Parameter]
    public EventCallback<string> OnFailed { get; set; }

    private string _title = "";
    private string _body = "";
    private int _priority = 3;
    private bool _private;
    private DateOnly _start;
    private DateOnly? _end;
    private DateOnly? _eventDate;
    private bool _saving;
    private string? _error;

    /// <summary>キーボードを除いた見える範囲にシートを合わせる購読。</summary>
    private IAsyncDisposable? _viewport;

    private bool _disposed;

    /// <summary>実施日が原因で、開始日・終了日を動かしたことの知らせ。</summary>
    private string? _info;

    /// <summary>実施日が、開始日から終了日の外にあるか。未設定は、外ではない。終了日が空のときは、終了日の側は常に中。PC 版と共通の判定 (<see cref="NoteInput.IsEventDateOutOfPeriod"/>)を使う。</summary>
    private bool IsEventOutOfPeriod => new NoteInput
    {
        StartDate = _start,
        EndDate = _end ?? DateOnly.MaxValue,
        EventDate = _eventDate ?? DateOnly.MaxValue,
    }.IsEventDateOutOfPeriod;

    /// <summary>警告に出す、実施日の表示。</summary>
    private string EventText => _eventDate?.ToString("yyyy/MM/dd") ?? "";

    protected override void OnInitialized()
    {
        if (Note is { } note)
        {
            _title = note.Title;
            _body = note.Body;
            _priority = note.Priority;
            _private = note.IsPrivate;
            _start = note.StartDate;
            _end = note.EndDate;
            _eventDate = note.EventDate;
        }
        else
        {
            _start = DefaultStart;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var viewport = await Browser.WatchSheetViewportAsync();
        if (_disposed)
        {
            await viewport.DisposeAsync();
            return;
        }
        _viewport = viewport;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_viewport is not null)
        {
            await _viewport.DisposeAsync();
        }
    }

    /// <summary>開始日を変えたとき、終了日より後になるなら、終了日を同じ日に合わせる。実施日は動かさず、期間の外に出たときは警告を出す。</summary>
    private void OnStartPicked(DateOnly day)
    {
        _info = null;
        _start = day;
        if (_end is { } end && end < day)
        {
            _end = day;
        }
    }

    /// <summary>終了日を変えたとき、開始日より前になるなら、開始日を同じ日に合わせる。実施日は動かさず、期間の外に出たときは警告を出す。</summary>
    private void OnEndPicked(DateOnly day)
    {
        _info = null;
        _end = day;
        if (day < _start)
        {
            _start = day;
        }
    }

    /// <summary>終了日をクリアして、無期限にする。実施日が、期間の外になることはない。</summary>
    private void OnEndCleared()
    {
        _info = null;
        _end = null;
    }

    /// <summary>実施日を変えたとき、期間の外ならば、開始日・終了日を動かして合わせる。終了日が空 (無期限)のときは、終了日は動かさない。</summary>
    private void OnEventPicked(DateOnly day)
    {
        _info = null;
        _eventDate = day;
        var messages = new List<string>();
        if (day < _start)
        {
            _start = day;
            messages.Add($"開始日を {day:yyyy/MM/dd} に早めました。");
        }
        if (_end is { } end && day > end)
        {
            _end = day;
            messages.Add($"終了日を {day:yyyy/MM/dd} に伸ばしました。");
        }
        _info = messages.Count > 0 ? string.Concat(messages) : null;
    }

    /// <summary>実施日をクリアして、未設定にする。</summary>
    private void OnEventCleared()
    {
        _info = null;
        _eventDate = null;
    }

    private async Task SaveAsync()
    {
        // 押せない条件は、次の描画まで効かない。続けて 2 回押されても、処理が 2 回動かないよう、先頭で確かめる
        if (_saving || string.IsNullOrWhiteSpace(_title) || IsEventOutOfPeriod)
        {
            return;
        }

        _saving = true;
        _error = null;
        var result = await Notes.SaveAsync(Note?.Id, new NoteSaveRequest(_title.Trim(), _body, _priority, _private, _start, _end, _eventDate));
        _saving = false;
        switch (result.Status)
        {
            case ApiFailure.None:
                await OnSaved.InvokeAsync();
                break;
            case ApiFailure.SignedOut:
                break;
            case ApiFailure.NotFound:
                await OnFailed.InvokeAsync(result.Message ?? "ノートが見つかりません。");
                break;
            default:
                _error = result.Message;
                break;
        }
    }
}
