@inject NotesClient Notes
@inject NavigationManager Navigation
@inject BrowserClient Browser
@implements IAsyncDisposable

<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
    <header class="sheet-bar">
        <button type="button" class="text" @onclick="OnCancel" disabled="@_saving">キャンセル</button>
        <h2 id="sheet-title">@(Note is null ? "新規ノート" : "ノートの編集")</h2>
        <button type="button" class="text strong" @onclick="SaveAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_title) || IsEventOutOfPeriod)">保存</button>
    </header>

    <div class="sheet-body">
        @if (_error is not null)
        {
            <p class="message" role="alert">@_error</p>
        }

        <label class="field">
            <span>タイトル</span>
            <input type="text" maxlength="100" autocomplete="off" @bind="_title" @bind:event="oninput" />
        </label>

        <label class="field">
            <span>本文</span>
            <textarea rows="10" @bind="_body" @bind:event="oninput"></textarea>
        </label>

        <div class="dates">
            <label class="field">
                <span>開始日</span>
                <input type="date" class="@InvalidClass" value="@_start.ToString("yyyy-MM-dd")" @onchange="OnStartChanged" />
            </label>

            <div class="field">
                <span>終了日</span>
                <input type="date" class="@InvalidClass" aria-label="終了日" value="@(_end?.ToString("yyyy-MM-dd"))" @onchange="OnEndChanged" />
                <div class="end-footer">
                    <button type="button" class="text" @onclick="OnEndCleared" disabled="@(_end is null)">クリア</button>
                </div>
                @if (_end is null)
                {
                    <small class="hint">空のときは無期限です</small>
                }
            </div>
        </div>

        <div class="dates">
            <div class="field">
                <span>実施日</span>
                <input type="date" class="@InvalidClass" aria-label="実施日" value="@(_eventDate?.ToString("yyyy-MM-dd"))" @onchange="OnEventChanged" />
                <div class="end-footer">
                    <button type="button" class="text" @onclick="OnEventCleared" disabled="@(_eventDate is null)">クリア</button>
                </div>
            </div>
        </div>

        @if (IsEventOutOfPeriod)
        {
            <p class="alert" role="alert">実施日 (@EventText)が期間の外です。開始日・終了日か実施日を直してください。</p>
        }
        else if (_info is not null)
        {
            <p class="info" role="status">@_info</p>
        }

        <fieldset class="priority">
            <legend>重要度</legend>
            <div class="segments">
                @foreach (var (value, label) in Priorities)
                {
                    <label class="segment">
                        <input type="radio" name="priority" checked="@(_priority == value)" @onchange="() => _priority = value" />
                        <span>@label</span>
                    </label>
                }
            </div>
        </fieldset>

        @if (Note is null || Note.IsMine)
        {
            <label class="check">
                <input type="checkbox" @bind="_private" />
                <span>自分だけに表示</span>
            </label>
        }
    </div>
</div>

@code {
    /// <summary>重要度の選択肢。左が低く、右が高い。</summary>
    private static readonly (int Value, string Label)[] Priorities = [(1, "最低"), (2, "低"), (3, "中"), (4, "高"), (5, "最高")];

    /// <summary>編集するノート。新規のときは null。</summary>
    [Parameter]
    public NoteDto? Note { get; set; }

    /// <summary>新規のときの開始日の初期値。画面が表示している日。</summary>
    [Parameter]
    public DateOnly DefaultStart { get; set; }

    /// <summary>保存できたときに呼ぶ。</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>取りやめたときに呼ぶ。</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>ノートが見つからなかったときに呼ぶ。ほかの人が先に変えた場合などで、理由を渡す。</summary>
    [Parameter]
    public EventCallback<string> OnFailed { get; set; }

    private string _title = "";
    private string _body = "";
    private int _priority = 3;
    private bool _private;
    private DateOnly _start;
    private DateOnly? _end;
    private DateOnly? _eventDate;
    private bool _saving;
    private string? _error;

    /// <summary>キーボードを除いた見える範囲にシートを合わせる購読。</summary>
    private IAsyncDisposable? _viewport;

    private bool _disposed;

    /// <summary>実施日が原因で、開始日・終了日を動かしたことの知らせ。</summary>
    private string? _info;

    /// <summary>実施日が、開始日から終了日の外にあるか。未設定は、外ではない。終了日が空のときは、終了日の側は常に中。</summary>
    private bool IsEventOutOfPeriod => _eventDate is { } date && (date < _start || (_end is { } end && date > end));

    /// <summary>警告に出す、実施日の表示。</summary>
    private string EventText => _eventDate?.ToString("yyyy/MM/dd") ?? "";

    /// <summary>期間の外の警告が出ている間、3 つの日付の欄に付ける class。</summary>
    private string InvalidClass => IsEventOutOfPeriod ? "invalid" : "";

    protected override void OnInitialized()
    {
        if (Note is { } note)
        {
            _title = note.Title;
            _body = note.Body;
            _priority = note.Priority;
            _private = note.IsPrivate;
            _start = note.StartDate;
            _end = note.EndDate;
            _eventDate = note.EventDate;
        }
        else
        {
            _start = DefaultStart;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var viewport = await Browser.WatchSheetViewportAsync();
        if (_disposed)
        {
            await viewport.DisposeAsync();
            return;
        }
        _viewport = viewport;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_viewport is not null)
        {
            await _viewport.DisposeAsync();
        }
    }

    /// <summary>開始日を変えたとき、終了日より後になるなら、終了日を同じ日に合わせる。実施日は動かさず、期間の外に出たときは警告を出す。</summary>
    private void OnStartChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var day))
        {
            _info = null;
            _start = day;
            if (_end is { } end && end < day)
            {
                _end = day;
            }
        }
    }

    /// <summary>終了日を変えたとき、開始日より前になるなら、開始日を同じ日に合わせる。実施日は動かさず、期間の外に出たときは警告を出す。</summary>
    private void OnEndChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var day))
        {
            _info = null;
            _end = day;
            if (day < _start)
            {
                _start = day;
            }
        }
    }

    /// <summary>終了日をクリアして、無期限にする。実施日が、期間の外になることはない。</summary>
    private void OnEndCleared()
    {
        _info = null;
        _end = null;
    }

    /// <summary>実施日を変えたとき、期間の外ならば、開始日・終了日を動かして合わせる。終了日が空 (無期限)のときは、終了日は動かさない。</summary>
    private void OnEventChanged(ChangeEventArgs e)
    {
        _info = null;
        if (!DateOnly.TryParse(e.Value?.ToString(), out var day))
        {
            _eventDate = null;
            return;
        }

        _eventDate = day;
        var messages = new List<string>();
        if (day < _start)
        {
            _start = day;
            messages.Add($"開始日を {day:yyyy/MM/dd} に早めました。");
        }
        if (_end is { } end && day > end)
        {
            _end = day;
            messages.Add($"終了日を {day:yyyy/MM/dd} に伸ばしました。");
        }
        _info = messages.Count > 0 ? string.Concat(messages) : null;
    }

    /// <summary>実施日をクリアして、未設定にする。</summary>
    private void OnEventCleared()
    {
        _info = null;
        _eventDate = null;
    }

    private async Task SaveAsync()
    {
        // 押せない条件は、次の描画まで効かない。続けて 2 回押されても、処理が 2 回動かないよう、先頭で確かめる
        if (_saving || string.IsNullOrWhiteSpace(_title) || IsEventOutOfPeriod)
        {
            return;
        }

        _saving = true;
        _error = null;
        var result = await Notes.SaveAsync(Note?.Id, new NoteSaveRequest(_title.Trim(), _body, _priority, _private, _start, _end, _eventDate));
        _saving = false;
        switch (result.Status)
        {
            case ApiFailure.None:
                await OnSaved.InvokeAsync();
                break;
            case ApiFailure.SignedOut:
                Navigation.NavigateTo("/", forceLoad: true);
                break;
            case ApiFailure.NotFound:
                await OnFailed.InvokeAsync(result.Message ?? "ノートが見つかりません。");
                break;
            default:
                _error = result.Message;
                break;
        }
    }
}
