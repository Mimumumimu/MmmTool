<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Reminders.Main.ReminderMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MmmSdk.WinUI.Controls"
    xmlns:local="using:MmmTool.Reminders.Main"
    xmlns:reminders="using:MmmTool.Reminders"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="リマインダー">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- 状態の切り替えの各ボタン。幅 360 でも件名が見えるよう、小さめに詰める (見た目・テンプレートは部品の既定のまま) -->
            <Style TargetType="toolkit:SegmentedItem">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- 1 行 (カード)。左から 状態の色の縦線 / 時刻 / 件名 (リンクがあれば押して開く) / 状態の切り替え -->
            <DataTemplate x:Key="RowTemplate" x:DataType="local:ReminderTodayItem">
                <Grid
                    Height="48"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="OnOpenLinkClick"
                                Icon="Link"
                                IsEnabled="{x:Bind HasLink, Mode=OneWay}"
                                Tag="{x:Bind}"
                                Text="リンクを開く" />
                            <MenuFlyoutItem
                                Click="OnEditClick"
                                Icon="Edit"
                                Tag="{x:Bind}"
                                Text="編集" />
                            <MenuFlyoutItem
                                Click="OnCopyAsNewClick"
                                Icon="Copy"
                                Tag="{x:Bind}"
                                Text="コピーして新規追加" />
                            <MenuFlyoutItem
                                Click="OnDeleteClick"
                                Icon="Delete"
                                Tag="{x:Bind}"
                                Text="削除"
                                Visibility="{x:Bind CanDelete}" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>

                    <Border
                        Grid.Column="0"
                        Width="6"
                        Margin="6,6,0,6"
                        Background="{x:Bind local:ReminderMainWindow.StatusBrush(Status), Mode=OneWay}"
                        CornerRadius="3" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{x:Bind TimeText, Mode=OneWay}" />
                    <controls:LinkArea
                        Grid.Column="2"
                        Margin="6,0,4,0"
                        Padding="4,4"
                        VerticalAlignment="Center"
                        ColumnSpacing="4"
                        CornerRadius="4"
                        IsLinkEnabled="{x:Bind HasLink, Mode=OneWay}"
                        Opacity="{x:Bind reminders:ReminderRowStyle.Opacity(IsDone), Mode=OneWay}"
                        Tag="{x:Bind}"
                        Tapped="OnTitleTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE71B;"
                            Visibility="{x:Bind HasLink, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextDecorations="{x:Bind reminders:ReminderRowStyle.Strike(IsDone), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </controls:LinkArea>
                    <toolkit:Segmented
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        SelectedIndex="{x:Bind StatusIndex, Mode=TwoWay}">
                        <!-- 既定はいちばん広いボタン (スヌーズ)に幅をそろえるので、文字の幅だけにして件名の場所を空ける -->
                        <toolkit:Segmented.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </toolkit:Segmented.ItemsPanel>
                        <toolkit:SegmentedItem Content="未" />
                        <toolkit:SegmentedItem Content="スヌーズ" />
                        <toolkit:SegmentedItem Content="完了" />
                    </toolkit:Segmented>
                </Grid>
            </DataTemplate>

            <!-- 行を縦に並べる -->
            <ItemsPanelTemplate x:Key="RowsPanel">
                <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Padding="14,10,48,2">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="リマインダー" />
        </Grid>

        <!-- 操作 -->
        <StackPanel
            Grid.Row="1"
            Margin="14,6,14,8"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Padding="10,4"
                Command="{x:Bind ViewModel.AddCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                    <TextBlock Text="新規追加" />
                </StackPanel>
            </Button>
            <Button Padding="10,4" Command="{x:Bind ViewModel.ShowListCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="13" Glyph="&#xE8FD;" />
                    <TextBlock Text="一覧" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 区切り線 -->
        <Rectangle
            Grid.Row="2"
            Height="1"
            Margin="14,0,14,6"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 今日の対象。未対応を上に、完了を下の折りたたみに -->
        <ScrollViewer Grid.Row="3">
            <StackPanel Margin="10,0,10,10" Spacing="6">
                <ItemsControl
                    ItemTemplate="{StaticResource RowTemplate}"
                    ItemsPanel="{StaticResource RowsPanel}"
                    ItemsSource="{x:Bind ViewModel.Pending}" />
                <Expander
                    Padding="6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{x:Bind ViewModel.DoneHeader, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasDone, Mode=OneWay}">
                    <ItemsControl
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsPanel="{StaticResource RowsPanel}"
                        ItemsSource="{x:Bind ViewModel.Done}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 今日の対象が無いとき -->
        <StackPanel
            Grid.Row="3"
            Margin="10,0,10,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE787;" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="今日のリマインダーはありません。" />
        </StackPanel>

        <!-- エラー。レイアウトに場所を取らず、一覧の上部に重ねる -->
        <InfoBar
            Grid.Row="3"
            Margin="10,0,10,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
