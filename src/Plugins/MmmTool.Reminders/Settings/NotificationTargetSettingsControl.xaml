<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Reminders.Settings.NotificationTargetSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Reminders.Settings">

    <!-- サーバーモードのときだけ並べる。部品そのものを、コードビハインドで隠す -->
    <StackPanel Spacing="4">
        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="通知先" />

        <InfoBar
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />

        <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:NotificationTargetItem">
                    <controls:SettingsCard Description="ほかの人から届いた通知を、選んだ端末で受け取ります。選べるのは、Web 版の「通知」で登録した端末です。" Header="{x:Bind Name}">
                        <ComboBox
                            Width="280"
                            DisplayMemberPath="Text"
                            ItemsSource="{x:Bind Options}"
                            SelectedItem="{x:Bind Selected, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
