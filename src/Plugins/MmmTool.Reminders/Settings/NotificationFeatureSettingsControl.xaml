<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Reminders.Settings.NotificationFeatureSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Reminders.Settings">

    <!-- サーバーモードのときだけ並べる。部品そのものを、コードビハインドで隠す -->
    <StackPanel Spacing="4">
        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="通知を受け取る機能" />

        <InfoBar
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />

        <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:NotificationFeatureItem">
                    <controls:SettingsCard Header="{x:Bind Name}">
                        <ToggleSwitch
                            IsOn="{x:Bind IsOn, Mode=TwoWay}"
                            OffContent="オフ"
                            OnContent="オン" />
                    </controls:SettingsCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
