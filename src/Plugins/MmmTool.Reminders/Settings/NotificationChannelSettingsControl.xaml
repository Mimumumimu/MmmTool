<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Reminders.Settings.NotificationChannelSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- サーバーモード (DB モード)のときだけ並べる (部品そのものを隠す。コードビハインド。ページの Spacing の場所も取らない) -->
    <StackPanel Spacing="4">
        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="送信先" />

        <controls:SettingsCard
            Command="{x:Bind ViewModel.OpenCommand}"
            Description="通知やメッセージを送る先 (ntfy・Discord)を登録します"
            Header="送信先の登録"
            IsClickEnabled="True" />
    </StackPanel>
</UserControl>
