<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Reminders.List.ReminderListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Reminders.List"
    xmlns:reminders="using:MmmTool.Reminders">

    <Grid>
        <Grid.Resources>
            <!-- 見出しと行で共通の列の幅。日付 / 曜日 / 時刻は固定で、残りを件名と備考で 2 対 3 に分ける -->
            <GridLength x:Key="DateColumnWidth">120</GridLength>
            <GridLength x:Key="WeekdayColumnWidth">120</GridLength>
            <GridLength x:Key="TimeColumnWidth">80</GridLength>
            <GridLength x:Key="TitleColumnWidth">2*</GridLength>
            <GridLength x:Key="NoteColumnWidth">3*</GridLength>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 操作 -->
        <Grid Grid.Row="0" Padding="0,0,0,12">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="96"
                    Command="{x:Bind ViewModel.AddCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="新規追加" />
                    </StackPanel>
                </Button>
                <Button MinWidth="96" Command="{x:Bind ViewModel.BulkAddCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE7C3;" />
                        <TextBlock Text="まとめて追加" />
                    </StackPanel>
                </Button>
                <!-- 送信先の登録 (DB モードだけ) -->
                <Button
                    MinWidth="96"
                    Command="{x:Bind ViewModel.OpenChannelsCommand}"
                    Visibility="{x:Bind ViewModel.IsChannelsVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                        <TextBlock Text="送信先の設定" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="24">
                <ToggleSwitch
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.ShowPast, Mode=TwoWay}"
                    OffContent="過去の予定を表示"
                    OnContent="過去の予定を表示" />
                <ToggleSwitch
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.ShowDeleted, Mode=TwoWay}"
                    OffContent="削除済みを表示"
                    OnContent="削除済みを表示" />
            </StackPanel>
        </Grid>

        <!-- 一覧 (見出しは固定で、行だけスクロール) -->
        <Grid
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 見出し。左右の余白は行 (ListViewItem の外側 4 + 内側 12)に合わせる -->
            <Grid
                Grid.Row="0"
                Padding="16,10,16,10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource DateColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource WeekdayColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource TimeColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource TitleColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource NoteColumnWidth}" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="日付" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="曜日" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="時刻" />
                <TextBlock
                    Grid.Column="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="件名" />
                <TextBlock
                    Grid.Column="4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="備考" />
            </Grid>

            <ListView
                x:Name="ReminderList"
                Grid.Row="1"
                Padding="0,4"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ReminderListItem">
                        <!-- 行全体でダブルタップ・右クリックを受けるため、背景を透明で塗る -->
                        <Grid
                            Background="Transparent"
                            DoubleTapped="OnRowDoubleTapped"
                            Opacity="{x:Bind reminders:ReminderRowStyle.Opacity(IsDeleted)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource DateColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource WeekdayColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource TimeColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource TitleColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource NoteColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnEditClick"
                                        Icon="Edit"
                                        Tag="{x:Bind}"
                                        Text="編集" />
                                    <MenuFlyoutItem
                                        Click="OnCopyAsNewClick"
                                        Icon="Copy"
                                        Tag="{x:Bind}"
                                        Text="コピーして新規追加" />
                                    <!-- 削除済みでない行は「削除」(作成者だけ)、削除済みの行は「完全削除」(完全削除に対応する保存先だけ) -->
                                    <MenuFlyoutItem
                                        Click="OnDeleteClick"
                                        Icon="Delete"
                                        Tag="{x:Bind}"
                                        Text="削除"
                                        Visibility="{x:Bind CanDelete}" />
                                    <MenuFlyoutItem
                                        Click="OnPurgeClick"
                                        Icon="Delete"
                                        Tag="{x:Bind}"
                                        Text="完全削除"
                                        Visibility="{x:Bind CanPurge}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{x:Bind DateText}"
                                TextDecorations="{x:Bind reminders:ReminderRowStyle.Strike(IsDeleted)}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind WeekdayText}"
                                TextDecorations="{x:Bind reminders:ReminderRowStyle.Strike(IsDeleted)}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind TimeText}"
                                TextDecorations="{x:Bind reminders:ReminderRowStyle.Strike(IsDeleted)}" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind Title}"
                                TextDecorations="{x:Bind reminders:ReminderRowStyle.Strike(IsDeleted)}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <!-- 備考は 1 行で出す。全文は、カーソルを合わせると表示する。備考が無い行は、空のツールチップを出さないよう隠す -->
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind NoteLine}"
                                TextDecorations="{x:Bind reminders:ReminderRowStyle.Strike(IsDeleted)}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Note}"
                                Visibility="{x:Bind HasNote}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- エラー。レイアウトに場所を取らず、一覧の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="8,8,8,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</UserControl>
