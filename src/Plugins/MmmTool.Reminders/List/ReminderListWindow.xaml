<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Reminders.List.ReminderListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="リマインダー一覧">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="リマインダー一覧" />
        </Grid>

        <!-- 一覧の中身 (ページと共有する ReminderListControl。コードで入れる) -->
        <Border
            x:Name="ListHost"
            Grid.Row="1"
            Padding="24,16,24,24" />
    </Grid>
</Window>
