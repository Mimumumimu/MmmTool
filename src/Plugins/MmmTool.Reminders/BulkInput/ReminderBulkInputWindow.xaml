<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Reminders.BulkInput.ReminderBulkInputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MmmSdk.WinUI.Controls"
    xmlns:core="using:MmmTool.Reminders.Core"
    xmlns:local="using:MmmTool.Reminders.BulkInput"
    xmlns:reminders="using:MmmTool.Reminders"
    Title="まとめて追加">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- 時刻の表の 1 行の高さ。開いたときのスクロール位置の計算にも使う -->
            <x:Double x:Key="SlotRowHeight">32</x:Double>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯。ドラッグで移動できる。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="まとめて追加" />
        </Grid>

        <!-- 左が全部の会議に付ける設定、中が時刻の表、右が選んだ会議の一覧 -->
        <Grid
            Grid.Row="1"
            Padding="24,8,24,0"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 全部の会議に付ける設定。送信先の一覧は、残りの高さいっぱいに伸びる -->
            <Grid Grid.Column="0" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CalendarDatePicker
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    Date="{x:Bind ViewModel.Date, Mode=TwoWay}"
                    DateFormat="{}{year.full}/{month.integer(2)}/{day.integer(2)}({dayofweek.abbreviated})"
                    Header="日付" />
                <ComboBox
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Name"
                    Header="何分前に通知"
                    ItemsSource="{x:Bind ViewModel.LeadOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedLead, Mode=TwoWay}" />
                <ToggleSwitch
                    Grid.Row="2"
                    Header="通知を読み上げる"
                    IsOn="{x:Bind ViewModel.IsSpeak, Mode=TwoWay}" />

                <!-- 送信先。DB モードで、送信先を読み込めたときだけ出す。複数選べて、何も選ばなければ送らない。送る処理は MmmBatch が行う -->
                <Grid
                    Grid.Row="3"
                    RowSpacing="8"
                    Visibility="{x:Bind ViewModel.IsChannelVisible, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="送信先" />
                    <reminders:ReminderChannelPicker
                        Grid.Row="1"
                        IsEmpty="{x:Bind ViewModel.HasNoChannels, Mode=OneWay}"
                        Options="{x:Bind ViewModel.ChannelOptions}" />
                </Grid>
            </Grid>

            <!-- 時刻の表。見出しは固定で、行だけスクロールする -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="会議の時刻" />
                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.Row="0"
                            Height="{StaticResource SlotRowHeight}"
                            Padding="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text=":00" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text=":30" />
                        </Grid>
                        <ScrollViewer
                            x:Name="TableScroll"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.HourRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReminderBulkHourRow">
                                        <Grid Height="{StaticResource SlotRowHeight}" Padding="12,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Label}" />
                                            <CheckBox
                                                Grid.Column="1"
                                                MinWidth="0"
                                                AutomationProperties.Name="{x:Bind Label}"
                                                IsChecked="{x:Bind OnTheHour.IsChecked, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Column="2"
                                                MinWidth="0"
                                                AutomationProperties.Name="{x:Bind Label}"
                                                IsChecked="{x:Bind HalfPast.IsChecked, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 選んだ会議の一覧。時刻・件名・リンクを直せる -->
            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.ListHeader, Mode=OneWay}" />
                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReminderBulkEntry">
                                        <StackPanel Padding="12,8,12,4">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <controls:TimeInputBox
                                                    Grid.Column="0"
                                                    Hour="{x:Bind Hour, Mode=TwoWay}"
                                                    Minute="{x:Bind Minute, Mode=TwoWay}" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    GotFocus="OnJapaneseBoxGotFocus"
                                                    MaxLength="{x:Bind core:ReminderDraft.TitleMaxLength}"
                                                    PlaceholderText="{x:Bind core:ReminderDraft.DefaultTitle}"
                                                    Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox
                                                    Grid.Column="2"
                                                    GotFocus="OnLinkBoxGotFocus"
                                                    InputScope="Url"
                                                    MaxLength="{x:Bind core:ReminderLimits.LinkMaxLength}"
                                                    PlaceholderText="リンク"
                                                    Text="{x:Bind Link, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Note, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasNote, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="時刻の表で、会議の時刻を選んでください。"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 操作ボタン。Windows の流儀で、肯定を左・キャンセルを右に置く -->
        <StackPanel
            Grid.Row="2"
            Padding="24,24,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.RegisterCommand}"
                Content="登録"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="キャンセル" />
        </StackPanel>

        <!-- 登録のエラー。レイアウトに場所を取らず、列の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.SaveError.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SaveError.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
