<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Reminders.ChannelEdit.NotificationChannelEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MmmTool.Reminders.Core"
    xmlns:local="using:MmmTool.Reminders.ChannelEdit"
    Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" />
        </Grid>

        <!-- 入力欄 -->
        <StackPanel
            Grid.Row="1"
            Padding="24,16,24,0"
            Spacing="12">

            <ComboBox
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Name"
                Header="種類"
                IsEnabled="{x:Bind ViewModel.IsKindEditable, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.KindOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}" />

            <!-- 登録名。エラーの行は場所を空けておく (出たり消えたりで下の欄が動かないように) -->
            <StackPanel Spacing="4">
                <TextBox
                    GotFocus="OnNameBoxGotFocus"
                    Header="登録名"
                    MaxLength="{x:Bind core:NotificationChannelRules.NameMaxLength}"
                    Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    MinHeight="16"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.NameError, Mode=OneWay}" />
            </StackPanel>

            <!-- ntfy と Discord は同じ場所に出す。高さは高いほうに合わせる (切り替えで下の欄が動かないように) -->
            <Grid MinHeight="140">
                <!-- ntfy: トピック名は自動で作る -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsNtfy, Mode=OneWay}">
                    <TextBox
                        GotFocus="OnTopicBoxGotFocus"
                        Header="トピック名"
                        MaxLength="{x:Bind core:NotificationChannelRules.NtfyTopicMaxLength}"
                        Text="{x:Bind ViewModel.NtfyTopic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        MinHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.TopicError, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button MinWidth="96" Command="{x:Bind ViewModel.CopyTopicCommand}" Content="コピー" />
                        <Button MinWidth="96" Command="{x:Bind ViewModel.RegenerateTopicCommand}" Content="作り直す" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="スマホの ntfy のアプリに、このトピック名を登録してください。&#x0A;ほかの人が推測できない名前にしてください。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Discord: Webhook の URL は伏せて入力する -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsDiscord, Mode=OneWay}">
                    <PasswordBox
                        Header="Webhook の URL"
                        MaxLength="{x:Bind core:NotificationChannelRules.ValueMaxLength}"
                        Password="{x:Bind ViewModel.DiscordUrl, Mode=TwoWay}" />
                    <TextBlock
                        MinHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.UrlError, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Discord のチャンネルの設定の「連携サービス」→「ウェブフック」で、URL をコピーします。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 操作ボタン (Windows の流儀で、肯定を左・キャンセルを右に) -->
        <StackPanel
            Grid.Row="2"
            Padding="24,24,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="保存"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="キャンセル" />
        </StackPanel>

        <!-- 保存のエラー。レイアウトに場所を取らず、入力欄の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.SaveError.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SaveError.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
