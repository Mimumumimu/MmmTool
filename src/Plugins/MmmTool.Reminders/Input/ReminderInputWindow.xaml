<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Reminders.Input.ReminderInputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MmmSdk.WinUI.Controls"
    xmlns:core="using:MmmTool.Reminders.Core"
    xmlns:local="using:MmmTool.Reminders.Input"
    Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" />
        </Grid>

        <!-- 入力欄 -->
        <StackPanel
            Grid.Row="1"
            Padding="24,16,24,0"
            Spacing="12">

            <!-- 件名。エラーの行は場所を空けておく (出たり消えたりで下の欄が動かないように) -->
            <StackPanel Spacing="4">
                <TextBox
                    x:Name="TitleBox"
                    GotFocus="OnJapaneseBoxGotFocus"
                    Header="件名"
                    MaxLength="{x:Bind core:ReminderLimits.TitleMaxLength}"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    MinHeight="16"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.TitleError, Mode=OneWay}" />
            </StackPanel>

            <!-- 発動の指定 (日付指定 / 曜日指定) -->
            <StackPanel Spacing="4">
                <ToggleSwitch Header="日付を指定する" IsOn="{x:Bind ViewModel.IsDateSpecified, Mode=TwoWay}" />

                <!-- 日付指定と曜日指定を同じ場所に出す。高さは高いほうに合わせる (切り替えで下の欄が動かないように) -->
                <Grid x:Name="DateArea">
                    <CalendarDatePicker
                        x:Name="DatePanel"
                        VerticalAlignment="Top"
                        Date="{x:Bind ViewModel.Date, Mode=TwoWay}"
                        DateFormat="{}{year.full}/{month.integer(2)}/{day.integer(2)}({dayofweek.abbreviated})"
                        Visibility="{x:Bind ViewModel.IsDateSpecified, Mode=OneWay}" />

                    <StackPanel
                        x:Name="WeekdayPanel"
                        VerticalAlignment="Top"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.IsWeekdaySpecified, Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.WeekdayOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:WeekdayOption">
                                    <ToggleButton
                                        Width="44"
                                        Content="{x:Bind Label}"
                                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="曜日を選ばない場合は毎日通知します。" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 時刻 (24 時間。1 つの枠に「時 : 分」) -->
            <StackPanel Spacing="8">
                <TextBlock Text="時刻" />
                <controls:TimeInputBox Hour="{x:Bind ViewModel.Hour, Mode=TwoWay}" Minute="{x:Bind ViewModel.Minute, Mode=TwoWay}" />
            </StackPanel>

            <TextBox
                GotFocus="OnJapaneseBoxGotFocus"
                Header="備考"
                MaxLength="{x:Bind core:ReminderLimits.NoteMaxLength}"
                Text="{x:Bind ViewModel.Note, Mode=TwoWay}" />

            <TextBox
                GotFocus="OnLinkBoxGotFocus"
                Header="リンク"
                InputScope="Url"
                MaxLength="{x:Bind core:ReminderLimits.LinkMaxLength}"
                PlaceholderText="URL / ファイル / フォルダーのパス"
                Text="{x:Bind ViewModel.Link, Mode=TwoWay}" />

            <ToggleSwitch Header="通知を読み上げる" IsOn="{x:Bind ViewModel.IsSpeak, Mode=TwoWay}" />

            <!-- 宛先 (DB モードで、今のユーザーを特定できているときだけ) -->
            <ComboBox
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Name"
                Header="宛先"
                ItemsSource="{x:Bind ViewModel.TargetOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsTargetVisible}" />

            <!-- 送信先 (DB モードで、送信先を読み込めたときだけ。送る処理は MmmBatch が行う) -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsChannelVisible, Mode=OneWay}">
                <TextBlock Text="送信先" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="送信先が登録されていません。"
                    Visibility="{x:Bind ViewModel.HasNoChannels, Mode=OneWay}" />
                <!-- 複数選べる (何も選ばなければ、送らない)。多いときは、この中だけがスクロールする -->
                <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ChannelOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ReminderChannelOption">
                                <CheckBox
                                    MinHeight="32"
                                    Content="{x:Bind Text}"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>

        <!-- 操作ボタン (Windows の流儀で、肯定を左・キャンセルを右に) -->
        <StackPanel
            Grid.Row="2"
            Padding="24,24,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="OK"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="キャンセル" />
        </StackPanel>

        <!-- 保存のエラー。レイアウトに場所を取らず、入力欄の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.SaveError.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SaveError.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
