<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Notes.Edit.NoteEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MmmTool.Notes.Core"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- 選択のボタン。5 つが横に並ぶので、小さめに詰める (見た目・テンプレートは部品の既定のまま) -->
            <Style TargetType="toolkit:SegmentedItem">
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinWidth" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" />
        </Grid>

        <!-- 入力欄。本文欄が、余った高さまで伸びる -->
        <Grid
            Grid.Row="1"
            Padding="24,16,24,0"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="TitleBox"
                FontFamily="BIZ UDGothic, MS Gothic, Consolas"
                GotFocus="OnJapaneseBoxGotFocus"
                Header="タイトル"
                MaxLength="{x:Bind core:NoteLimits.TitleMaxLength}"
                Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 本文。普通の文章で書く。右クリックで、書式やリンクを足せる。ファイルをドロップすると、リンクが入る -->
            <TextBox
                x:Name="BodyBox"
                Grid.Row="1"
                MinHeight="120"
                AcceptsReturn="True"
                AllowDrop="True"
                FontFamily="BIZ UDGothic, MS Gothic, Consolas"
                GotFocus="OnJapaneseBoxGotFocus"
                Header="本文"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <!-- 期間。終了日が空なら無期限 -->
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                Spacing="8">
                <CalendarDatePicker
                    x:Name="StartDatePicker"
                    Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                    Header="開始日" />
                <TextBlock
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,6"
                    Text="～" />
                <CalendarDatePicker
                    x:Name="EndDatePicker"
                    Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                    Header="終了日"
                    PlaceholderText="無期限" />
                <Button
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ClearEndDateCommand}"
                    Content="クリア"
                    ToolTipService.ToolTip="終了日をクリアして、無期限にします" />
            </StackPanel>

            <!-- 実施日。空は未設定。期間の外に入れると、開始日・終了日が動く -->
            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="8">
                <CalendarDatePicker
                    x:Name="EventDatePicker"
                    Date="{x:Bind ViewModel.EventDate, Mode=TwoWay}"
                    Header="実施日"
                    PlaceholderText="なし" />
                <Button
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ClearEventDateCommand}"
                    Content="クリア"
                    ToolTipService.ToolTip="実施日をクリアして、未設定にします" />
            </StackPanel>

            <!-- 重要度 -->
            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock Text="重要度" />
                <toolkit:Segmented HorizontalAlignment="Left" SelectedIndex="{x:Bind ViewModel.PriorityIndex, Mode=TwoWay}">
                    <toolkit:SegmentedItem Content="最低" />
                    <toolkit:SegmentedItem Content="低" />
                    <toolkit:SegmentedItem Content="中" />
                    <toolkit:SegmentedItem Content="高" />
                    <toolkit:SegmentedItem Content="最高" />
                </toolkit:Segmented>
            </StackPanel>

            <!-- 公開範囲 (DB モードだけ。オフは全員に見える。変えられるのは、書いた人だけ) -->
            <CheckBox
                Grid.Row="5"
                Content="自分だけに表示"
                IsChecked="{x:Bind ViewModel.IsPrivate, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanChangeVisibility, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsShared}" />
        </Grid>

        <!-- 期間の警告と、期間を動かした知らせ。入力欄に重ねず、ボタンの上に場所を取る (警告は直すまで出続けるため) -->
        <StackPanel
            Grid.Row="2"
            Margin="24,12,24,0"
            Spacing="8">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsPeriodErrorOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.PeriodErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.AdjustInfo.IsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.AdjustInfo.Message, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>

        <!-- 操作ボタン (Windows の流儀で、肯定を左・キャンセルを右に) -->
        <StackPanel
            Grid.Row="3"
            Padding="24,24,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="OK"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="キャンセル" />
        </StackPanel>

        <!-- 保存のエラー。レイアウトに場所を取らず、入力欄の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.SaveError.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SaveError.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
