<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Notes.Edit.NoteEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MmmTool.Notes.Core"
    xmlns:local="using:MmmTool.Notes.Edit"
    xmlns:controls="using:MmmSdk.WinUI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- 選択のボタン。5 つが横に並ぶので、小さめに詰める (見た目・テンプレートは部品の既定のまま) -->
            <Style TargetType="toolkit:SegmentedItem">
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <!-- ほかの実施日の一覧の 1 行。高さ 32 で、一覧の高さ (3 行ぶん)を計算で決めるため -->
            <Style x:Key="OtherDateItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0,4,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯で、ドラッグで移動できる。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" />
        </Grid>

        <!-- 入力欄の 2 列。左はタイトルと本文で、本文が余った幅と高さまで伸びる。右は内容の幅で、期間・実施日・ほかの実施日・重要度・公開範囲 -->
        <Grid
            x:Name="ContentGrid"
            Grid.Row="1"
            Padding="24,16,24,0"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左の列: タイトルと本文。下に、期間の警告と知らせの InfoBar。右の列は縮められないので、InfoBar が出たときは本文が縮んで場所を空ける -->
            <Grid x:Name="MainColumn" Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="TitleBox"
                    FontFamily="BIZ UDGothic, MS Gothic, Consolas"
                    GotFocus="OnJapaneseBoxGotFocus"
                    Header="タイトル"
                    MaxLength="{x:Bind core:NoteLimits.TitleMaxLength}"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- タイトルの下。種類が日程のときだけ、本文と日程のタブを出す。選んだタブの中身が、残りの高さを使う -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <SelectorBar
                        x:Name="TabBar"
                        Margin="0,0,0,8"
                        SelectionChanged="OnTabChanged"
                        Visibility="{x:Bind ViewModel.ShowTabs, Mode=OneWay}">
                        <SelectorBarItem Text="本文" />
                        <SelectorBarItem IsSelected="True" Text="日程" />
                    </SelectorBar>

                    <!-- 本文。普通の文章で書く。上のボタンか右クリックで、書式やリンクを足せる。ファイルをドロップすると、リンクが入る -->
                    <Grid
                        Grid.Row="1"
                        RowSpacing="4"
                        Visibility="{x:Bind ViewModel.ShowBody, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 書式のボタンの列。ボタンは、右クリックのメニューと同じ定義から、コードで作る。ボタンの左端は、本文欄の枠に合わせる -->
                    <StackPanel
                        x:Name="FormatBar"
                        Margin="-4,0,0,0"
                        Orientation="Horizontal"
                        Spacing="2" />

                    <TextBox
                        x:Name="BodyBox"
                        Grid.Row="1"
                        MinHeight="120"
                        AcceptsReturn="True"
                        AllowDrop="True"
                        AutomationProperties.Name="本文"
                        FontFamily="BIZ UDGothic, MS Gothic, Consolas"
                        GotFocus="OnJapaneseBoxGotFocus"
                        PlaceholderText="本文"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    </Grid>

                    <!-- 日程の入力。日付ごとにまとまりを作り、予定を縦に並べる。時刻は空にできる。1 件を 1 行にして、開始・終了・内容・備考を常に出す -->
                    <Border
                        Grid.Row="1"
                        Padding="12"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{x:Bind ViewModel.ShowSchedule, Mode=OneWay}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Button
                                x:Name="AddScheduleDateButton"
                                HorizontalAlignment="Left"
                                Click="OnAddScheduleDateClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE787;" />
                                    <TextBlock Text="日付を追加" />
                                </StackPanel>
                            </Button>

                            <!-- 列の見出し。予定の行と同じ列の定義で、スクロールバーの分だけ右をあける。列はすべて固定の幅か割合で、手で寄せない -->
                            <Grid
                                Grid.Row="1"
                                Margin="0,0,12,0"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="開始" />
                                <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="終了" />
                                <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="内容" />
                                <TextBlock Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="備考" />
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Schedule.Days}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ScheduleDayGroup">
                                            <!-- 日ごとのまとまり。上の細い線が、日の切れ目 -->
                                            <Border
                                                Margin="0,0,12,0"
                                                Padding="0,8,0,8"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="4">
                                                <!-- 日付の見出し。右のボタンで、その日の予定ごと別の日へ移せる -->
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <!-- 日付の文字。土曜は青、日曜と祝日は赤。色はテーマごとに変わるので、種類ごとに文字を 1 つずつ置き、該当する 1 つだけを出す -->
                                                    <Grid VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind DateText, Mode=OneWay}"
                                                            Visibility="{x:Bind IsPlainDay, Mode=OneWay}" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource WeekdaySaturdayBrush}"
                                                            Text="{x:Bind DateText, Mode=OneWay}"
                                                            Visibility="{x:Bind IsSaturday, Mode=OneWay}" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource WeekdaySundayBrush}"
                                                            Text="{x:Bind DateText, Mode=OneWay}"
                                                            Visibility="{x:Bind IsSunday, Mode=OneWay}" />
                                                    </Grid>
                                                    <Button
                                                        Padding="6,4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        AutomationProperties.Name="日付を変える"
                                                        Click="OnChangeScheduleDateClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="日付を変える">
                                                        <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                                    </Button>
                                                    <Button
                                                        Padding="6,4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        AutomationProperties.Name="他の日付にコピー"
                                                        Click="OnCopyScheduleDateClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="他の日付にコピー">
                                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                    </Button>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{x:Bind Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:ScheduleItemEditor">
                                                            <!-- 1 件を 1 行にする。開始・終了・内容・備考を、常にすべて出し、使わない欄は空のままにする。列の定義は、上の見出しと同じ -->
                                                            <Grid Margin="0,0,0,4" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="112" />
                                                                    <ColumnDefinition Width="16" />
                                                                    <ColumnDefinition Width="112" />
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="3*" />
                                                                    <ColumnDefinition Width="40" />
                                                                </Grid.ColumnDefinitions>

                                                                <controls:TimeInputBox
                                                                    HorizontalAlignment="Stretch"
                                                                    AllowEmpty="True"
                                                                    AutomationProperties.Name="開始"
                                                                    Hour="{x:Bind StartHour, Mode=TwoWay}"
                                                                    IsEmpty="{x:Bind StartIsEmpty, Mode=TwoWay}"
                                                                    Minute="{x:Bind StartMinute, Mode=TwoWay}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Text="～" />
                                                                <controls:TimeInputBox
                                                                    Grid.Column="2"
                                                                    HorizontalAlignment="Stretch"
                                                                    AllowEmpty="True"
                                                                    AutomationProperties.Name="終了"
                                                                    Hour="{x:Bind EndHour, Mode=TwoWay}"
                                                                    IsEmpty="{x:Bind EndIsEmpty, Mode=TwoWay}"
                                                                    Minute="{x:Bind EndMinute, Mode=TwoWay}" />
                                                                <TextBox
                                                                    Grid.Column="3"
                                                                    MinHeight="32"
                                                                    Padding="12,5,12,5"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="内容"
                                                                    GotFocus="{x:Bind local:NoteEditWindow.TurnOnIme}"
                                                                    MaxLength="{x:Bind core:NoteLimits.ScheduleTextMaxLength}"
                                                                    PlaceholderText="内容"
                                                                    Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBox
                                                                    Grid.Column="4"
                                                                    MinHeight="32"
                                                                    Padding="12,5,12,5"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="備考"
                                                                    GotFocus="{x:Bind local:NoteEditWindow.TurnOnIme}"
                                                                    MaxLength="{x:Bind core:NoteLimits.ScheduleTextMaxLength}"
                                                                    PlaceholderText="備考"
                                                                    Text="{x:Bind Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <Button
                                                                    Grid.Column="5"
                                                                    Padding="8,6"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="削除"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Click="OnRemoveScheduleItemClick"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="削除">
                                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <HyperlinkButton
                                                    Padding="0"
                                                    Command="{x:Bind AddItemCommand}"
                                                    Content="＋ この日に予定を追加" />
                                            </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 期間の警告と、期間を動かした知らせ。入力欄に重ねない。警告は、直すまで出続ける -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsPeriodErrorOpen, Mode=OneWay}"
                        Message="{x:Bind ViewModel.PeriodErrorMessage, Mode=OneWay}"
                        Severity="Error" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.AdjustInfo.IsOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.AdjustInfo.Message, Mode=OneWay}"
                        Severity="Informational" />
                </StackPanel>
            </Grid>

            <!-- 右の列。広い範囲を決める期間が先で、実施日とほかの実施日は、その中に入る日。日程のときだけ、コードで、タイトルの下の横 1 列に移す -->
            <StackPanel x:Name="SideColumn" Grid.Column="1" Spacing="12">

                <!-- 期間。終了日が空なら無期限 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker
                        x:Name="StartDatePicker"
                        Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                        Header="開始日" />
                    <TextBlock
                        Margin="0,0,0,6"
                        VerticalAlignment="Bottom"
                        Text="～" />
                    <CalendarDatePicker
                        x:Name="EndDatePicker"
                        Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                        Header="終了日"
                        PlaceholderText="無期限" />
                    <Button
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ClearEndDateCommand}"
                        Content="クリア"
                        ToolTipService.ToolTip="終了日をクリアして、無期限にします" />
                </StackPanel>

                <!-- 実施日。空は未設定。期間の外に入れると、開始日・終了日が動く。ほかの実施日にある日にはできない -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsNormal, Mode=OneWay}">
                    <CalendarDatePicker
                        x:Name="EventDatePicker"
                        Date="{x:Bind ViewModel.EventDate, Mode=TwoWay}"
                        Header="実施日"
                        PlaceholderText="なし" />
                    <Button
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ClearEventDateCommand}"
                        Content="クリア"
                        ToolTipService.ToolTip="実施日をクリアして、未設定にします" />
                </StackPanel>

                <!-- ほかの実施日。見出しの右に追加のボタン。下の一覧は、3 行ぶん (32 × 3 + 枠 2)で高さを固定し、4 本以上は一覧の中だけがスクロールする -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsNormal, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="ほかの実施日" />
                        <Button
                            x:Name="AddOtherDateButton"
                            Grid.Column="1"
                            Click="OnAddOtherEventDateClick"
                            Content="実施日を追加" />
                    </Grid>

                    <Grid Height="98">
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4" />
                        <ListView
                            Margin="1"
                            ItemContainerStyle="{StaticResource OtherDateItemStyle}"
                            ItemsSource="{x:Bind ViewModel.OtherEventDates}"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:OtherEventDateItem">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{x:Bind local:NoteEditWindow.ForegroundOf(IsInvalid), Mode=OneWay}"
                                            Text="{x:Bind Text}" />
                                        <Button
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            AutomationProperties.Name="削除"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind RemoveCommand}"
                                            ToolTipService.ToolTip="削除">
                                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 一覧が空のときの薄い文字。日付が入ったときの 1 行目と同じ位置に、上揃えで置く (枠 1 + 行の余白 12 = 左 13、行の高さ 32 の中の文字 = 上 7) -->
                        <TextBlock
                            Margin="13,7,0,0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsHitTestVisible="False"
                            Text="なし"
                            Visibility="{x:Bind ViewModel.IsOtherEventDatesEmpty, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <!-- 重要度 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="重要度" />
                    <toolkit:Segmented HorizontalAlignment="Left" SelectedIndex="{x:Bind ViewModel.PriorityIndex, Mode=TwoWay}">
                        <toolkit:SegmentedItem Content="最低" />
                        <toolkit:SegmentedItem Content="低" />
                        <toolkit:SegmentedItem Content="中" />
                        <toolkit:SegmentedItem Content="高" />
                        <toolkit:SegmentedItem Content="最高" />
                    </toolkit:Segmented>
                </StackPanel>

                <!-- 公開範囲。DB モードだけで、オフは全員に見える。変えられるのは、書いた人だけ -->
                <CheckBox
                    Content="自分だけに表示"
                    IsChecked="{x:Bind ViewModel.IsPrivate, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanChangeVisibility, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsShared}" />
            </StackPanel>
        </Grid>

        <!-- 操作ボタン (Windows の流儀で、肯定を左・キャンセルを右に) -->
        <StackPanel
            Grid.Row="2"
            Padding="24,24,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="OK"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="キャンセル" />
        </StackPanel>

        <!-- 保存のエラー。レイアウトに場所を取らず、入力欄の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.SaveError.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SaveError.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
