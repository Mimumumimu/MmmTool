<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.Notes.Main.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Notes.Main">

    <!-- 見出し・操作の行・カードを、同じ幅の 1 本の列にして中央に置く (広い画面でも、右端が揃い、本文の 1 行が長くなりすぎない) -->
    <Grid
        MaxWidth="1048"
        Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出しと、毎日使う操作 (新規)。表示を切り替える部品とは並べない -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ノート" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.NewNoteCommand}"
                Content="新規"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- 表示する日 (左)と、表示の切り替え (右) -->
        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    AutomationProperties.Name="前の日"
                    Command="{x:Bind ViewModel.PreviousDayCommand}"
                    ToolTipService.ToolTip="前の日">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>
                <CalendarDatePicker x:Name="DatePicker" DateChanged="OnDateChanged" />
                <Button
                    AutomationProperties.Name="次の日"
                    Command="{x:Bind ViewModel.NextDayCommand}"
                    ToolTipService.ToolTip="次の日">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
                <Button Command="{x:Bind ViewModel.TodayCommand}" Content="今日" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="16">
                <!-- 左から右へ、広く効く順 (全部の見た目 → 出すものの追加) -->
                <ToggleSwitch
                    MinWidth="0"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.IsTitleOnly, Mode=TwoWay}"
                    OffContent="タイトルだけ"
                    OnContent="タイトルだけ" />
                <CheckBox
                    MinWidth="0"
                    Padding="8,0,0,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="削除したものも表示"
                    IsChecked="{x:Bind ViewModel.ShowDeleted, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- 行の間は、行ごとの上の余白で取る (行の間隔の指定だと、閉じている InfoBar の行の分も空いてしまうため)。閉じている InfoBar は、自分自身は残って余白が効くので、Visibility でも畳む -->
        <InfoBar
            Grid.Row="2"
            Margin="0,12,0,0"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />

        <!-- その日のノートのカード。ページ全体が 1 枚の読み物で、スクロールはカード一覧の中だけ -->
        <local:NoteCardsView
            x:Name="CardsView"
            Grid.Row="3"
            Margin="0,8,0,0" />
    </Grid>
</Page>
