<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.WorkItems.Schedule.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.WorkItems.Schedule"
    xmlns:main="using:MmmTool.WorkItems.Main"
    xmlns:picker="using:MmmTool.WorkItems.ProjectPicker"
    xmlns:sdk="using:MmmSdk.WinUI.Controls"
    xmlns:wi="using:MmmTool.WorkItems"
    Loaded="OnLoaded">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 案件・グループの文字の色と、行の背景は、作業管理の表と共有する (WorkItemTheme) -->
            <ResourceDictionary.MergedDictionaries>
                <wi:WorkItemTheme />
            </ResourceDictionary.MergedDictionaries>

            <!-- カード (作業管理・リンク・クリップボード転送のページと同じ) -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- 計算値 (案件・グループの値)の表示 -->
            <Style x:Key="CellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource GroupTextBrush}" />
            </Style>

            <!-- 作業の値の表示 -->
            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 名前 (木構造の列。字下げと開閉ボタンは表が付ける)。案件は太字・濃い青、グループはやや太字・青 (作業管理の表と同じ) -->
            <DataTemplate x:Key="NameCell" x:DataType="local:ScheduleRow">
                <Grid>
                    <TextBlock
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        Visibility="{x:Bind IsWork}" />
                    <TextBlock
                        FontSize="{x:Bind main:WorkItemOptions.ProjectFontSize}"
                        FontWeight="Bold"
                        Foreground="{ThemeResource ProjectTextBrush}"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        Visibility="{x:Bind IsProject}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GroupTextBrush}"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        Visibility="{x:Bind IsSubGroup}" />
                </Grid>
            </DataTemplate>

            <!-- 担当 (作業だけ) -->
            <DataTemplate x:Key="AssigneeCell" x:DataType="local:ScheduleRow">
                <TextBlock Style="{StaticResource ValueTextStyle}" Text="{x:Bind AssigneeName, Mode=OneWay}" />
            </DataTemplate>

            <!-- 進捗。期限切れの作業は、右に警告のアイコンを付ける (色だけで伝えない)。触れると、過ぎた日数を出す -->
            <DataTemplate x:Key="ProgressCell" x:DataType="local:ScheduleRow">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind ProgressText, Mode=OneWay}"
                        Visibility="{x:Bind IsWork}" />
                    <TextBlock
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind ProgressText, Mode=OneWay}"
                        Visibility="{x:Bind IsGroup}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE7BA;"
                        ToolTipService.ToolTip="{x:Bind OverdueText, Mode=OneWay}"
                        Visibility="{x:Bind IsOverdue, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>

            <!-- 日付の棒 (行ごとに描く) -->
            <DataTemplate x:Key="TimelineCell" x:DataType="local:ScheduleRow">
                <local:ScheduleTimelineCell Row="{x:Bind}" />
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出しと、ページ全体の操作。更新ボタンは、どのページでも右端に置く (DB モードだけ) -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="スケジュール" />
            <sdk:RefreshButton
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Visibility="{x:Bind ViewModel.CanRefresh}" />
        </Grid>

        <!-- エラー (操作のたびに、前の分は消える) -->
        <InfoBar
            Grid.Row="1"
            Grid.RowSpan="3"
            VerticalAlignment="Top"
            Canvas.ZIndex="10"
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error" />

        <!-- 表示の操作。左は、範囲の動かし方 (今日・単位)、右は、出す行の絞り込み (広い順: 表示する案件 → 自分の担当だけ → 完了) -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Click="OnTodayClick" Content="今日" />
                <SelectorBar x:Name="UnitBar" SelectionChanged="OnUnitSelectionChanged">
                    <SelectorBarItem IsSelected="True" Text="日" />
                    <SelectorBarItem Text="週" />
                    <SelectorBarItem Text="月" />
                </SelectorBar>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="16">
                <picker:ProjectPickerButton x:Name="ProjectPickerControl" />
                <ToggleSwitch
                    MinWidth="0"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.MineOnly, Mode=TwoWay}"
                    OffContent="自分の担当だけ"
                    OnContent="自分の担当だけ"
                    Visibility="{x:Bind ViewModel.HasAssignees}" />
                <!-- 完了した作業の見え方。選択肢の並びは CompletedDisplay の値と同じ。保存しない。幅は、作業管理と同じ固定の値 -->
                <!-- ComboBox の既定の VerticalAlignment は Top で、隣のボタンと高さがずれるため、中央にそろえる -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="完了" />
                    <ComboBox
                        Width="152"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="完了"
                        SelectedIndex="{x:Bind ViewModel.CompletedIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="表示" />
                        <ComboBoxItem Content="グループのみ表示" />
                        <ComboBoxItem Content="非表示" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 表。行が無いときは、案内を出す -->
        <Border Grid.Row="3" Padding="1" Style="{StaticResource CardStyle}">
            <Grid>
                <sdk:TreeGridView
                    x:Name="TimelineGrid"
                    FrozenBackground="{ThemeResource InputRowBackgroundBrush}"
                    SummaryBackground="{ThemeResource GroupRowBackgroundBrush}" />
                <TextBlock
                    Margin="0,64,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsHitTestVisible="False"
                    Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
