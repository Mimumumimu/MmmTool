<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.WorkItems.Main.WorkItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.WorkItems.Main"
    xmlns:picker="using:MmmTool.WorkItems.ProjectPicker"
    xmlns:sdk="using:MmmSdk.WinUI.Controls"
    xmlns:wi="using:MmmTool.WorkItems"
    Loaded="OnLoaded">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 案件・グループの文字の色と、行の背景は、スケジュールと共有する (WorkItemTheme) -->
            <ResourceDictionary.MergedDictionaries>
                <wi:WorkItemTheme />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 毎日入力する列の見出しの下線の色 (背景は塗らない。入力の手がかりの灰色と区別する)。毎日入力する列は、SDK の表の面の色 (見出しと同じ系統)のまま -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DailyLineBrush" Color="#2E9E6B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DailyLineBrush" Color="#4CC38A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 右クリックのメニュー (中身は開くときに、コードで作る)。入力欄にも同じものを付け、入力欄の既定のメニューを出さない -->
            <MenuFlyout x:Key="RowMenu" />

            <!-- カード (リンク・クリップボード転送のページと同じ) -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- セルの入力欄 (枠と背景を出さず、触ったときだけ入力欄の見た目になる) -->
            <Style x:Key="CellTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
            </Style>

            <Style x:Key="CellComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CellDatePickerStyle" TargetType="CalendarDatePicker">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <!-- 備考のセル (先頭の 1 行を出し、押すと入力欄が開く) -->
            <Style x:Key="NoteButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <!-- 計算値 (入力できない値)の表示 -->
            <Style x:Key="CellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource GroupTextBrush}" />
            </Style>

            <!-- 入力できる値の表示 (計算値の CellTextStyle より濃い文字色) -->
            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 入力の手がかり (空のときだけ出す薄い文字) -->
            <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>

            <!--
                セルは、普段は表示用 (…Cell)の文字だけを出し、入力するときだけ、入力用 (…Edit)に切り替わる。
                表示用の外側の Border は、空のセルでも、クリックを受けるための透明な背景
            -->

            <!-- 名前 (木構造の列。字下げと開閉ボタンは表が付ける) -->
            <DataTemplate x:Key="NameCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <TextBlock
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        Visibility="{x:Bind IsWork}" />
                    <TextBlock
                        FontSize="{x:Bind local:WorkItemOptions.ProjectFontSize}"
                        FontWeight="Bold"
                        Foreground="{ThemeResource ProjectTextBrush}"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        Visibility="{x:Bind IsProject, Mode=OneWay}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GroupTextBrush}"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        Visibility="{x:Bind IsSubGroup, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NameEdit" x:DataType="local:WorkItemRow">
                <TextBox
                    x:Name="Col_Name"
                    ContextFlyout="{StaticResource RowMenu}"
                    FontWeight="{x:Bind local:WorkItemOptions.NameWeight(IsGroup, Level), Mode=OneWay}"
                    GotFocus="OnCellGotFocus"
                    InputScope="Hiragana"
                    KeyDown="OnTextCellKeyDown"
                    LostFocus="OnTextCellLostFocus"
                    MaxLength="200"
                    Style="{StaticResource CellTextBoxStyle}"
                    Text="{x:Bind Name, Mode=OneWay}" />
            </DataTemplate>

            <DataTemplate x:Key="AssigneeCell" x:DataType="local:WorkItemRow">
                <TextBlock
                    Style="{StaticResource ValueTextStyle}"
                    Text="{x:Bind AssigneeText, Mode=OneWay}"
                    Visibility="{x:Bind IsWork}" />
            </DataTemplate>

            <DataTemplate x:Key="PriorityCell" x:DataType="local:WorkItemRow">
                <TextBlock
                    Style="{StaticResource ValueTextStyle}"
                    Text="{x:Bind PriorityText, Mode=OneWay}"
                    Visibility="{x:Bind IsWork}" />
            </DataTemplate>

            <DataTemplate x:Key="StartCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <TextBlock
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind StartText, Mode=OneWay}"
                        Visibility="{x:Bind IsWork}" />
                    <TextBlock
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind StartText, Mode=OneWay}"
                        Visibility="{x:Bind IsGroup}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="StartEdit" x:DataType="local:WorkItemRow">
                <CalendarDatePicker
                    x:Name="Col_Start"
                    Closed="OnDateClosed"
                    ContextFlyout="{StaticResource RowMenu}"
                    Date="{x:Bind StartValue, Mode=OneWay}"
                    DateChanged="OnCellDateChanged"
                    DateFormat="{}{year.full}/{month.integer(2)}/{day.integer(2)}"
                    Loaded="OnDateLoaded"
                    Opened="OnDateOpened"
                    PlaceholderText=""
                    Style="{StaticResource CellDatePickerStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="DueCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <TextBlock
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind DueText, Mode=OneWay}"
                        Visibility="{x:Bind IsDueNormal, Mode=OneWay}" />
                    <!-- 期限切れ (未完了で、期限日が入力日より前)。色だけに頼らないよう、警告のアイコンも付ける。列の幅は、カレンダーのボタンの分の余白に収まる -->
                    <StackPanel
                        Orientation="Horizontal"
                        Visibility="{x:Bind IsOverdue, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind OverdueTip, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{x:Bind DueText, Mode=OneWay}" />
                        <FontIcon
                            Margin="-4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE7BA;" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind DueText, Mode=OneWay}"
                        Visibility="{x:Bind IsGroup}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DueEdit" x:DataType="local:WorkItemRow">
                <CalendarDatePicker
                    x:Name="Col_Due"
                    Closed="OnDateClosed"
                    ContextFlyout="{StaticResource RowMenu}"
                    Date="{x:Bind DueValue, Mode=OneWay}"
                    DateChanged="OnCellDateChanged"
                    DateFormat="{}{year.full}/{month.integer(2)}/{day.integer(2)}"
                    Loaded="OnDateLoaded"
                    Opened="OnDateOpened"
                    PlaceholderText=""
                    Style="{StaticResource CellDatePickerStyle}" />
            </DataTemplate>

            <DataTemplate x:Key="PlannedCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind PlannedText, Mode=OneWay}"
                        Visibility="{x:Bind IsWork}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource HintTextStyle}"
                        Text="時間 (H)"
                        Visibility="{x:Bind PlannedHintVisible, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind PlannedText, Mode=OneWay}"
                        Visibility="{x:Bind IsGroup}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="PlannedEdit" x:DataType="local:WorkItemRow">
                <TextBox
                    x:Name="Col_Planned"
                    InputScope="Number"
                    BeforeTextChanging="OnNumberBeforeTextChanging"
                    ContextFlyout="{StaticResource RowMenu}"
                    GotFocus="OnCellGotFocus"
                    KeyDown="OnTextCellKeyDown"
                    LostFocus="OnTextCellLostFocus"
                    PlaceholderText="時間 (H)"
                    Style="{StaticResource CellTextBoxStyle}"
                    Text="{x:Bind PlannedText, Mode=OneWay}"
                    TextAlignment="Right" />
            </DataTemplate>

            <!-- 完了日。作業・グループとも入力できない (作業は、状態が完了に変わった入力日。グループ・案件は、下の作業の完了日の最大値で、完了したときだけ) -->
            <DataTemplate x:Key="CompletedCell" x:DataType="local:WorkItemRow">
                <TextBlock
                    Style="{StaticResource CellTextStyle}"
                    Text="{x:Bind CompletedText, Mode=OneWay}" />
            </DataTemplate>

            <!-- 実績 (累計)。作業・グループとも入力できない -->
            <DataTemplate x:Key="ActualTotalCell" x:DataType="local:WorkItemRow">
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource CellTextStyle}"
                    Text="{x:Bind ActualTotalText, Mode=OneWay}" />
            </DataTemplate>

            <!-- リンク。案件・グループ・作業とも、1 つ付けられる。リンクがある行だけ「リンク」と出し (パスは出さない。ポイントすると出る)、押すと開く。入れる・直すのは、右クリックのメニューの「リンクを編集…」 -->
            <DataTemplate x:Key="LinkCell" x:DataType="local:WorkItemRow">
                <TextBlock
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource ValueTextStyle}"
                    Text="リンク"
                    TextDecorations="Underline"
                    ToolTipService.ToolTip="{x:Bind Link, Mode=OneWay}"
                    Visibility="{x:Bind HasLink, Mode=OneWay}" />
            </DataTemplate>

            <!-- 毎日入力する列 -->
            <DataTemplate x:Key="StatusCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <TextBlock
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        Visibility="{x:Bind IsWork}" />
                    <TextBlock
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        Visibility="{x:Bind IsGroup}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ProgressCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <TextBlock
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind ProgressCellText, Mode=OneWay}"
                        Visibility="{x:Bind IsWork}" />
                    <TextBlock
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind ProgressCellText, Mode=OneWay}"
                        Visibility="{x:Bind IsGroup}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ActualDayCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource ValueTextStyle}"
                        Text="{x:Bind ActualDayText, Mode=OneWay}"
                        Visibility="{x:Bind IsWork}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource HintTextStyle}"
                        Text="時間 (H)"
                        Visibility="{x:Bind ActualDayHintVisible, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind ActualDayText, Mode=OneWay}"
                        Visibility="{x:Bind IsGroup}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ActualDayEdit" x:DataType="local:WorkItemRow">
                <TextBox
                    x:Name="Col_ActualDay"
                    InputScope="Number"
                    BeforeTextChanging="OnNumberBeforeTextChanging"
                    ContextFlyout="{StaticResource RowMenu}"
                    GotFocus="OnCellGotFocus"
                    KeyDown="OnTextCellKeyDown"
                    LostFocus="OnTextCellLostFocus"
                    PlaceholderText="時間 (H)"
                    Style="{StaticResource CellTextBoxStyle}"
                    Text="{x:Bind ActualDayText, Mode=OneWay}"
                    TextAlignment="Right" />
            </DataTemplate>

            <DataTemplate x:Key="DayNoteCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <!-- 案件・グループの行は、日ごとの備考が無い (入力できない) ので、ハイフンを出す -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Text="-"
                        Visibility="{x:Bind IsGroup}" />
                    <Button
                        x:Name="Col_DayNote"
                        IsEnabled="{x:Bind CanOpenDayNote, Mode=OneWay}"
                        IsTabStop="False"
                        ContextFlyout="{StaticResource RowMenu}"
                        Style="{StaticResource NoteButtonStyle}"
                        Visibility="{x:Bind IsWork}">
                        <!-- 触れない行 (無効)でも、行の灰色の背景をそのまま見せる (無効の既定の背景が、行の色を隠すため) -->
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind DayNoteFirstLine, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button.Flyout>
                            <Flyout
                                Closed="OnNoteFlyoutClosed"
                                Opened="OnNoteFlyoutOpened"
                                Opening="OnNoteFlyoutOpening"
                                Placement="BottomEdgeAlignedLeft">
                                <TextBox
                                    Width="360"
                                    Height="140"
                                    AcceptsReturn="True"
                                    InputScope="Hiragana"
                                    KeyDown="OnNoteKeyDown"
                                    MaxLength="1000"
                                    TextWrapping="Wrap" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NoteCell" x:DataType="local:WorkItemRow">
                <Grid>
                    <Button
                        x:Name="Col_Note"
                        IsEnabled="{x:Bind CanOpenNote, Mode=OneWay}"
                        IsTabStop="False"
                        ContextFlyout="{StaticResource RowMenu}"
                        Style="{StaticResource NoteButtonStyle}">
                        <!-- 触れない行 (無効)でも、行の灰色の背景をそのまま見せる (無効の既定の背景が、行の色を隠すため) -->
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind NoteFirstLine, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button.Flyout>
                            <Flyout
                                Closed="OnNoteFlyoutClosed"
                                Opened="OnNoteFlyoutOpened"
                                Opening="OnNoteFlyoutOpening"
                                Placement="BottomEdgeAlignedLeft">
                                <TextBox
                                    Width="360"
                                    Height="140"
                                    AcceptsReturn="True"
                                    InputScope="Hiragana"
                                    KeyDown="OnNoteKeyDown"
                                    MaxLength="1000"
                                    TextWrapping="Wrap" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 見出しと、ページ全体の操作の入口。作業報告 (毎日使う)と、案件の管理 (案件の追加・名前の変更・削除。案件は全員で共有するので、行のない所の右クリックでは作らない) -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="作業管理" />
            <!-- ページ全体の操作。毎日使う「作業報告」を内側に、日々の操作ではない「案件の管理」を端に置く。下のバーは、表示を切り替えるものだけにする -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.OpenReportCommand}" Content="作業報告" />
                <Button Command="{x:Bind ViewModel.OpenProjectManagerCommand}" Content="案件の管理" />
            </StackPanel>
        </Grid>

        <!-- エラー (操作のたびに、前の分は消える) -->
        <InfoBar
            Grid.Row="1"
            Grid.RowSpan="3"
            VerticalAlignment="Top"
            Canvas.ZIndex="10"
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error" />

        <!-- 入力日と、表示の操作。主な操作は表への入力なので、強調色のボタンは置かない -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="入力日" />
                <Button
                    AutomationProperties.Name="前の日"
                    Command="{x:Bind ViewModel.PreviousDayCommand}"
                    ToolTipService.ToolTip="前の日">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>
                <CalendarDatePicker x:Name="InputDatePicker" DateChanged="OnInputDateChanged" />
                <Button
                    AutomationProperties.Name="次の日"
                    Command="{x:Bind ViewModel.NextDayCommand}"
                    ToolTipService.ToolTip="次の日">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
                <Button Command="{x:Bind ViewModel.TodayCommand}" Content="今日" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="16">
                <!-- 左から右へ、範囲の広い順 (表示する案件 → 自分の担当だけ → 完了)。表示列は行の出し入れではないので、最後 -->
                <!-- 表示する案件を選ぶ (チェックを入れ外しすると、その場で保存して、画面に出し入れする) -->
                <picker:ProjectPickerButton x:Name="ProjectPickerControl" />
                <ToggleSwitch
                    MinWidth="0"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.MineOnly, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasAssignees}"
                    OffContent="自分の担当だけ"
                    OnContent="自分の担当だけ" />
                <!-- 完了して日がたった作業の見え方。選択肢の並びは CompletedDisplay の値と同じ。保存しない。幅は、選択肢が収まる固定の値 (選ぶたび・開くたびに幅が変わると、右寄せの左隣のボタンの位置が動くため) -->
                <!-- ComboBox の既定の VerticalAlignment は Top で、隣のボタンと高さがずれるため、中央にそろえる -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="過去の完了" />
                    <ComboBox
                        Width="152"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="過去の完了"
                        SelectedIndex="{x:Bind ViewModel.CompletedIndex, Mode=TwoWay}"
                        ToolTipService.ToolTip="入力日に完了した作業は、常に表示します">
                        <ComboBoxItem Content="表示" />
                        <ComboBoxItem Content="グループのみ表示" />
                        <ComboBoxItem Content="非表示" />
                    </ComboBox>
                </StackPanel>
                <DropDownButton x:Name="ColumnsButton" Content="表示列" />
            </StackPanel>
        </Grid>

        <!-- 表。行が無いときは、追加のしかたを案内する (追加のボタンが無いため) -->
        <Border Grid.Row="3" Padding="1" Style="{StaticResource CardStyle}">
            <Grid>
                <sdk:TreeGridView x:Name="TreeGrid" FrozenBackground="{ThemeResource InputRowBackgroundBrush}"
                    SummaryBackground="{ThemeResource GroupRowBackgroundBrush}" />
                <TextBlock
                    Margin="0,64,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsHitTestVisible="False"
                    Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- 日報メモ (作業に結びつかない、入力日の記入。打ち合わせなど)。毎日は書かないので、表の下に置く。見出しは付けず、空のときの薄い文字で、どの日のメモかを示す。フォーカスが外れたときに保存する (入力欄の既定の更新のタイミング)。高さは、行数 (DayNoteLines)から計算して決める (FitDayNoteHeight)。フォントを 1 つに決めるのは、英数字と日本語で行の高さが変わらないようにするため。作業報告のプレビューと同じ等幅のフォント -->
        <TextBox
            x:Name="DayNoteBox"
            Grid.Row="4"
            AcceptsReturn="True"
            AutomationProperties.Name="日報メモ"
            FontFamily="BIZ UDGothic, MS Gothic, Consolas"
            InputScope="Hiragana"
            MaxLength="{x:Bind ViewModel.DayNoteMaxLength}"
            PlaceholderText="{x:Bind ViewModel.DayNotePlaceholder, Mode=OneWay}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Text="{x:Bind ViewModel.DayNote, Mode=TwoWay}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
