<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="MmmTool.WorkItems.WorkItemTheme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        作業管理の表とスケジュールが共有する色 (案件 (濃い青)・グループ (青)の文字の色と、行の背景)。
        背景は、明るい表示では灰色ではなく、青の薄い色 (灰色は、入力できないように見えるため)。グループの行は少し濃く、入力する行の固定の列は、さらに薄くする
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GroupTextBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="ProjectTextBrush" Color="#0B4F8F" />
            <SolidColorBrush x:Key="GroupRowBackgroundBrush" Color="#DDEAFA" />
            <SolidColorBrush x:Key="InputRowBackgroundBrush" Color="#EAF2FC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GroupTextBrush" Color="#7BBCFF" />
            <SolidColorBrush x:Key="ProjectTextBrush" Color="#B5D8FF" />
            <SolidColorBrush x:Key="GroupRowBackgroundBrush" Color="#1E2B3C" />
            <SolidColorBrush x:Key="InputRowBackgroundBrush" Color="#20262F" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
