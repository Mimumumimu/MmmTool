<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MmmTool.WorkItems.Move.MoveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.WorkItems.Move"
    Title="移動先を選択"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonText="移動"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ListView
        x:Name="DestinationList"
        Width="420"
        MaxHeight="360"
        SelectionChanged="OnSelectionChanged"
        SelectionMode="Single">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:MoveDestination">
                <StackPanel Margin="{x:Bind Indent}" Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</ContentDialog>
