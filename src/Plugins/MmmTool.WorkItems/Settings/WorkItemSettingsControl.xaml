<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.WorkItems.Settings.WorkItemSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:options="using:MmmTool.WorkItems.ViewOptions"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="4">
        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="作業管理" />

        <!-- 保存に失敗したとき (閉じている間は、Spacing の分の場所も取らない) -->
        <InfoBar
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />

        <!-- 選択肢の名前と並びは、画面の「表示」の入れ物と同じ (CompletedDisplay の値の順) -->
        <controls:SettingsCard Description="アプリの起動時の表示。画面で変えた表示は保存しません" Header="作業管理の過去の完了">
            <ComboBox
                Width="176"
                IsEnabled="{x:Bind ViewModel.IsEditable}"
                ItemsSource="{x:Bind options:CompletedDisplaySection.Names}"
                SelectedIndex="{x:Bind ViewModel.PastCompletedIndex, Mode=TwoWay}" />
        </controls:SettingsCard>

        <controls:SettingsCard Description="アプリの起動時の表示。画面で変えた表示は保存しません" Header="スケジュールの完了">
            <ComboBox
                Width="176"
                IsEnabled="{x:Bind ViewModel.IsEditable}"
                ItemsSource="{x:Bind options:CompletedDisplaySection.Names}"
                SelectedIndex="{x:Bind ViewModel.ScheduleCompletedIndex, Mode=TwoWay}" />
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
