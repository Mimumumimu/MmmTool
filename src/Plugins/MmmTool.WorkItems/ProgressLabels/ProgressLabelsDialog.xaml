<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MmmTool.WorkItems.ProgressLabels.ProgressLabelsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.WorkItems.ProgressLabels"
    Title="進捗度のラベル"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonText="保存"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid Width="420" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="進捗度の値のあとに出すラベルを変えられます。空にすると、数値だけになります。"
            TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" MaxHeight="400">
            <ItemsControl ItemsSource="{x:Bind Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ProgressLabelEditItem">
                        <Grid Margin="0,0,0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ValueText}" />
                            <TextBox
                                Grid.Column="1"
                                InputScope="Hiragana"
                                MaxLength="50"
                                PlaceholderText="ラベルなし"
                                Text="{x:Bind Label, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ContentDialog>
