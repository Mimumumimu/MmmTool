<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmToolAdmin.Users.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:connection="using:MmmTool.Data.SqlServer.WinUI.Connection"
    xmlns:local="using:MmmToolAdmin.Users">

    <Grid Padding="24,16,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,12"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="ユーザー" />

        <!-- 選んだ人の登録用コードを出す。使える状態の人を選んだときだけ押せる -->
        <Button
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,0,0,12"
            Command="{x:Bind ViewModel.IssueCodeCommand}"
            Content="登録用コードを発行"
            Style="{StaticResource AccentButtonStyle}" />

        <!-- 発行したコード。コードは選んでコピーできる -->
        <InfoBar
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,0,0,12"
            IsOpen="{x:Bind ViewModel.IsIssuedOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.IssuedMessage, Mode=OneWay}"
            Severity="Success"
            Title="{x:Bind ViewModel.IssuedTitle, Mode=OneWay}">
            <TextBlock
                Margin="0,0,0,12"
                FontFamily="Consolas"
                FontSize="28"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.IssuedCode, Mode=OneWay}" />
        </InfoBar>

        <!-- 見出し。一覧の行と、列の幅と左右の余白をそろえる -->
        <Grid Grid.Row="3" Margin="16,0,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="表示名" />
            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ログイン名" />
            <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状態" />
        </Grid>

        <Grid Grid.Row="4">
            <ListView
                ItemsSource="{x:Bind ViewModel.Items}"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:UserItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind LoginName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Status}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- エラー。レイアウトに場所を取らず、一覧の上部に重ねる -->
            <connection:ConnectionErrorBar
                Margin="8,8,8,0"
                VerticalAlignment="Top"
                ViewModel="{x:Bind ViewModel}" />
        </Grid>

        <!-- 選んだ人の、機能の利用。状態を選ぶと、すぐ保存する。欄は常に出して、選ぶたびに一覧の幅が変わらないようにする -->
        <StackPanel
            Grid.Row="3"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="320"
            Margin="24,0,0,0">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="機能の利用" />
            <TextBlock
                Margin="0,4,0,16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Selected.DisplayName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
            <TextBlock
                Margin="0,4,0,16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="ユーザーを選ぶと、機能の利用を設定できます。"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.FeatureItems}" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:FeatureAccessItem">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                            <ComboBox
                                Grid.Column="1"
                                Width="120"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind Options}"
                                SelectedItem="{x:Bind Selected, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>
