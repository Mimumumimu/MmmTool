<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.Messages.Main.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MmmTool.Messages.Core"
    xmlns:links="using:MmmSdk.WinUI.Components.TextLinks"
    xmlns:local="using:MmmTool.Messages.Main">

    <Page.Resources>
        <!-- 会話の一覧の行 -->
        <DataTemplate x:Key="ConversationRowTemplate" x:DataType="local:ConversationItem">
            <StackPanel Padding="0,6" Spacing="2">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind TimeText}" />
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind LastText}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind NoteText}"
                    Visibility="{x:Bind local:MessagesPage.Visible(HasNote)}" />
            </StackPanel>
        </DataTemplate>

        <!-- 宛先に選べる人の行 -->
        <DataTemplate x:Key="PersonRowTemplate" x:DataType="local:PersonItem">
            <TextBlock Padding="0,8" Text="{x:Bind DisplayName}" />
        </DataTemplate>

        <!-- 受け取ったメッセージ。左に寄せ、カードの色にする -->
        <DataTemplate x:Key="OtherTemplate" x:DataType="local:ChatMessageItem">
            <Grid Margin="0,0,0,8" HorizontalAlignment="Left">
                <Border
                    MaxWidth="460"
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind SenderText}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind QuoteText}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind local:MessagesPage.Visible(HasQuote)}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"
                            links:LinkedText.LinkCommand="{x:Bind OpenLinkCommand}"
                            links:LinkedText.Text="{x:Bind Body}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind TimeText}" />
                            <HyperlinkButton Click="OnReplyClick" Content="返信" Padding="4,0" Tag="{x:Bind}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 自分が送ったメッセージ。右に寄せ、強調色にする。通知の状態の印は、送信待ちと失敗のときだけ出す -->
        <DataTemplate x:Key="MineTemplate" x:DataType="local:ChatMessageItem">
            <Grid Margin="0,0,0,8" HorizontalAlignment="Right">
                <Border
                    MaxWidth="460"
                    Padding="12,8"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind QuoteText}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind local:MessagesPage.Visible(HasQuote)}" />
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"
                            links:LinkedText.LinkCommand="{x:Bind OpenLinkCommand}"
                            links:LinkedText.LinkForeground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            links:LinkedText.Text="{x:Bind Body}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind TimeText}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind MarkText}"
                                Visibility="{x:Bind local:MessagesPage.Visible(HasMark)}" />
                            <HyperlinkButton
                                Click="OnReplyClick"
                                Content="返信"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Padding="4,0"
                                Tag="{x:Bind}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <local:ChatMessageTemplateSelector
            x:Key="MessageTemplateSelector"
            MineTemplate="{StaticResource MineTemplate}"
            OtherTemplate="{StaticResource OtherTemplate}" />
    </Page.Resources>

    <!-- 行の間隔は付けない。非表示の InfoBar の行にも間隔が付き、見出しの下が他の機能より空くため、下の余白は各部品に付ける -->
    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,12"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="メッセージ" />

        <InfoBar
            Grid.Row="1"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsUnavailableVisible}"
            Message="メッセージは、サーバーモードで使えます。"
            Severity="Informational"
            Visibility="{x:Bind ViewModel.IsUnavailableVisible}" />

        <InfoBar
            Grid.Row="2"
            Margin="0,0,0,12"
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />

        <Grid Grid.Row="3" ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsAvailable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <!-- 右は、残りの幅を使い、720 で止める。止まったあとの余りは、右に空ける -->
                <ColumnDefinition Width="*" MaxWidth="720" />
            </Grid.ColumnDefinitions>

            <!-- 左: 会話の一覧。「新しい会話」を押すと、宛先に選べる人の一覧に替わる -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 上の行は、右の会話の題名の行と同じ高さにして、下の枠の上端をそろえる。ボタンは上に寄せ、見出しとの間を他の機能のボタンと同じにする -->
                <Button
                    VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.PickPersonCommand}"
                    Content="新しい会話"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsConversationListVisible, Mode=OneWay}" />
                <Button
                    VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.CancelPickPersonCommand}"
                    Content="戻る"
                    Visibility="{x:Bind ViewModel.IsPeopleListVisible, Mode=OneWay}" />

                <!-- 一覧は、線の枠で囲み、中は地の色と違う不透明な色にする (CLI補助のターミナルと同じ) -->
                <Border
                    Grid.Row="1"
                    Padding="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <!-- 開いている会話の行を、標準の選択の見た目で示す。会話を開くのは行を押したときだけで、選択の変更では開かない (矢印キーや一覧の並び替えで、会話が切り替わらないため) -->
                        <ListView
                            x:Name="ConversationList"
                            IsItemClickEnabled="True"
                            ItemClick="OnConversationClick"
                            ItemTemplate="{StaticResource ConversationRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.Conversations}"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                            SelectionMode="Single"
                            SingleSelectionFollowsFocus="False"
                            Visibility="{x:Bind ViewModel.IsConversationListVisible, Mode=OneWay}" />

                        <ListView
                            IsItemClickEnabled="True"
                            ItemClick="OnPersonClick"
                            ItemTemplate="{StaticResource PersonRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.People}"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            SelectionMode="None"
                            Visibility="{x:Bind ViewModel.IsPeopleListVisible, Mode=OneWay}" />

                        <TextBlock
                            Margin="16,24,16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.EmptyNoticeText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsEmptyNoticeVisible, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 右: 会話と入力欄。会話を開いていないときは、案内だけを出す -->
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="会話を選ぶか、「新しい会話」で宛先を選んでください。"
                Visibility="{x:Bind ViewModel.IsConversationClosed, Mode=OneWay}" />

            <Grid
                Grid.Column="1"
                RowSpacing="8"
                Visibility="{x:Bind ViewModel.IsConversationOpen, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.ConversationTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="最新でない可能性があります。"
                        Visibility="{x:Bind ViewModel.IsStale, Mode=OneWay}" />
                </StackPanel>

                <!-- 会話は、線の枠で囲み、中は地の色と違う不透明な色にする -->
                <Border
                    Grid.Row="1"
                    Padding="8,4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <!-- 行ごとの出現アニメーションは切る。差し替えのたびに、全部の行が透明から現れて、空に見えるため -->
                        <ListView
                            x:Name="MessageList"
                            ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                            ItemsSource="{x:Bind ViewModel.Messages}"
                            Loaded="OnMessageListLoaded"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>

                        <!-- 会話を切り替えるとき、前の会話の見た目を撮って重ねる画像。下で中身を差し替えながら、薄くして消す -->
                        <Image
                            x:Name="SwitchSnapshot"
                            IsHitTestVisible="False"
                            Stretch="Fill" />

                        <!-- 端末の控えが無い会話を読んでいる間の仮の行。下から、相手・自分の順に並べる -->
                        <StackPanel
                            Margin="16,0,16,16"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.IsSkeletonVisible, Mode=OneWay}">
                            <Border Width="260" Height="44" HorizontalAlignment="Left" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="8" />
                            <Border Width="200" Height="32" HorizontalAlignment="Right" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="8" />
                            <Border Width="320" Height="56" HorizontalAlignment="Left" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="8" />
                            <Border Width="180" Height="32" HorizontalAlignment="Right" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="8" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="受け取り先が未設定です"
                    Visibility="{x:Bind ViewModel.IsNoReceiveTargetVisible, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind local:MessagesViewModel.SelfNoReceiveTargetText}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsSelfNoReceiveTargetVisible, Mode=OneWay}" />

                <Grid Grid.Row="3" ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasReplyTo, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ReplyToText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.CancelReplyCommand}"
                        Content="返信をやめる" />
                </Grid>

                <!-- 送信欄。入力と送信を、CLI補助の送信欄と同じ作りの 1 枚のカードにまとめる。入力欄は 3 行分の高さ固定で、超えた分は欄内でスクロールする -->
                <Border
                    Grid.Row="4"
                    Padding="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Height="64"
                            Padding="0,1"
                            AcceptsReturn="True"
                            GotFocus="OnJapaneseBoxGotFocus"
                            IsEnabled="{x:Bind ViewModel.IsInputEnabled, Mode=OneWay}"
                            MaxLength="{x:Bind core:MessageLimits.BodyMaxLength}"
                            PlaceholderText="メッセージ (Ctrl+Enter で送信)"
                            PreviewKeyDown="OnBodyPreviewKeyDown"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap">
                            <!-- カードの中に溶け込ませる (枠と背景を消す) -->
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.SendCommand}"
                            Content="送信"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
