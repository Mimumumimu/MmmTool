<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Messages.Main.MessageSendWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Messages.Main"
    Title="メッセージ送信">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Padding="14,10,48,2">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="メッセージ送信" />
        </Grid>

        <!-- 本文欄が、ウィンドウの余った高さまで伸びる (スクロールの入れ物には入れない) -->
        <local:MessageSendControl
            x:Name="SendControl"
            Grid.Row="1"
            Margin="14,6,14,14" />
    </Grid>
</Window>
