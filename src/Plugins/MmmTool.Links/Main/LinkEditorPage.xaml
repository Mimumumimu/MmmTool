<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.Links.Main.LinkEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Links.Main"
    Loaded="OnLoaded">

    <Page.Resources>
        <!-- 左右のカード -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル + 未保存のしるし -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="リンク" />
            <Border
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                CornerRadius="10"
                Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="未保存の変更があります" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 操作ツールバー -->
        <CommandBar
            Grid.Row="1"
            Margin="-4,0,0,0"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right">
            <AppBarButton Command="{x:Bind ViewModel.AddLinkCommand}" Label="リンクを追加">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71B;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.AddFolderCommand}" Label="フォルダーを追加">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8F4;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.AddSeparatorCommand}" Label="区切り線を追加">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE738;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.DeleteCommand}"
                Label="削除"
                ToolTipService.ToolTip="削除 (Delete)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Command="{x:Bind ViewModel.SaveCommand}" Label="保存">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74E;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.DiscardCommand}" Label="変更を破棄">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7A7;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- 本体: 左ツリー / 右編集欄 (2:3) -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- 左: ツリー -->
            <Border Padding="4,8" Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- 並べ替え・階層移動はドラッグ＆ドロップ。リンクと区切り線は子を持てないので、その上へは落とせない (AllowDrop) -->
                    <TreeView
                        x:Name="LinkTree"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        ItemsSource="{x:Bind ViewModel.RootItems}"
                        KeyDown="OnTreeKeyDown"
                        SelectionChanged="OnTreeSelectionChanged"
                        SelectionMode="Single">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:LinkTreeItem">
                                <TreeViewItem
                                    AllowDrop="{x:Bind IsFolder}"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind Children}">
                                    <Grid>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            Visibility="{x:Bind IsNotSeparator}">
                                            <FontIcon FontSize="16" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- 区切り線は行いっぱいの横線で表す -->
                                        <Rectangle
                                            Height="1"
                                            Margin="0,0,12,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                            Visibility="{x:Bind IsSeparator}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.OpenSelectedCommand}"
                                    Text="開く"
                                    Visibility="{x:Bind ViewModel.IsLinkSelected, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.AddLinkCommand}" Text="リンクを追加">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.AddFolderCommand}" Text="フォルダーを追加">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.AddSeparatorCommand}" Text="区切り線を追加">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE738;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.DeleteCommand}"
                                    KeyboardAcceleratorTextOverride="Delete"
                                    Text="削除">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TreeView.ContextFlyout>
                    </TreeView>

                    <!-- 項目が無いときの案内 -->
                    <StackPanel
                        MaxWidth="280"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <FontIcon
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE71B;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="リンクはまだありません" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="よく開く URL・フォルダー・ファイルを登録すると、トレイのメニューからすぐ開けます。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.AddLinkCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="最初のリンクを追加" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右: 選択項目の編集 -->
            <Border
                Grid.Column="1"
                Padding="24,20"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- リンク・フォルダーの編集欄 -->
                    <ScrollViewer Visibility="{x:Bind ViewModel.IsEditorVisible, Mode=OneWay}">
                        <!-- 入力欄は、左寄せのまま、広がっても 640 までにする -->
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="640" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="20">
                            <!-- 種類の見出し -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border
                                    Width="36"
                                    Height="36"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="{x:Bind ViewModel.SelectedItem.Glyph, Mode=OneWay, FallbackValue=''}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="リンク"
                                        Visibility="{x:Bind ViewModel.IsLinkSelected, Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="フォルダー"
                                        Visibility="{x:Bind ViewModel.IsFolderSelected, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="クリックすると、パスの先を開きます"
                                        Visibility="{x:Bind ViewModel.IsLinkSelected, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="トレイのメニューではサブメニューになります"
                                        Visibility="{x:Bind ViewModel.IsFolderSelected, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBox
                                x:Name="NameBox"
                                Header="名前"
                                Text="{x:Bind ViewModel.SelectedItem.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />

                            <!-- パス (リンクのとき)。手入力が基本で、参照は補助 -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsLinkSelected, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Header="パス"
                                        PlaceholderText="https://…　C:\…　\\server\share\…"
                                        Text="{x:Bind ViewModel.SelectedItem.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                                    <DropDownButton
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="参照"
                                        ToolTipService.ToolTip="ファイルやフォルダーを選んでパスに入れる">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                                            <TextBlock Text="参照" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Command="{x:Bind ViewModel.BrowseFileCommand}" Text="ファイルを選ぶ…">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Command="{x:Bind ViewModel.BrowseFolderCommand}" Text="フォルダーを選ぶ…">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8B7;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </Grid>

                                <!-- パスの種類 (存在しなければ注意) -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsPathFound, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind ViewModel.PathKindGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.PathKindText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsPathNotFound, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="{x:Bind ViewModel.PathKindGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.PathKindText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="%USERPROFILE% などの環境変数も使えます。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Command="{x:Bind ViewModel.OpenSelectedCommand}"
                                Visibility="{x:Bind ViewModel.IsLinkSelected, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                    <TextBlock Text="開いて確かめる" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 未選択・区切り線のときの案内 -->
                    <StackPanel
                        MaxWidth="320"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsEditorHintVisible, Mode=OneWay}">
                        <FontIcon
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE70F;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.EditorHint, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 通知 (保存完了・エラー)。レイアウトに場所を取らないよう、本体の下部に重ねて出す -->
            <StackPanel
                Grid.ColumnSpan="2"
                MaxWidth="560"
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Spacing="8">
                <Border
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}">
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
                        Severity="Error" />
                </Border>
                <Border
                    x:Name="SavedNotice"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Visibility="Collapsed">
                    <InfoBar
                        x:Name="SavedInfoBar"
                        Closed="OnSavedInfoBarClosed"
                        Message="保存しました。"
                        Severity="Success" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
