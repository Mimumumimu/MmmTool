<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmToolAdmin.Shell.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:MmmSdk.WinUI.Components.Pages"
    Title="MmmToolAdmin">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <pages:NavigationHistoryButtons x:Name="HistoryButtons" Margin="4,0,0,0" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="MmmToolAdmin" />
            </StackPanel>
        </Grid>

        <!-- サイドバーと、選んだ機能のページを表示する SDK の NavigationHost を、コードで入れる -->
        <Border x:Name="ContentHost" Grid.Row="1" />
    </Grid>
</Window>
