<?xml version="1.0" encoding="utf-8"?>
<!--
発行プロファイル。VS の「発行」と、コマンドの dotnet publish .\src\App\MmmToolWeb\Server\MmmToolWeb.Server.csproj -p:PublishProfile=win-x64 の両方で使う
(構成・プラットフォーム・出力先だけを書く。発行の設定の本体は build\AppDistribution.targets)
出力先は、途中のフォルダ obj\Release\publish\ にする。
配布物 bin\Release\publish\MmmToolWeb\ は、発行のあとに PackageDistribution が作る。
Client (ブラウザで動く画面)の出力は、発行のときに自動で wwwroot\ にコピーされる。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>obj\$(Configuration)\publish\</PublishDir>
  </PropertyGroup>
</Project>
