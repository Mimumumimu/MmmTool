<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 言語別リソース (NuGet 由来のサテライト DLL)を日本語・英語だけにする (MmmBatch と同じ) -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <!-- ブラウザのデバッグ用の BlazorDebugProxy は、Release の出力と発行物に入れない (VS で F5 するときの Debug にだけ要る) -->
    <BlazorWebAssemblyOmitDebugProxyOutput Condition="'$(Configuration)' == 'Release'">true</BlazorWebAssemblyOmitDebugProxyOutput>
    <!-- 配布物のフォルダ名。説明書と版は持たず、bin\<構成>\publish\MmmToolWeb\ にできる -->
    <DistributionFolderName>MmmToolWeb</DistributionFolderName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ライセンスは MIT License の本文で、アプリ本体の Assets\Licenses に置く。同梱ライブラリのライセンス全文は共有の発行の仕組みが作る -->
    <None Include="..\..\..\..\LICENSE.txt" Link="Assets\Licenses\LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fido2.AspNet" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <ItemGroup>
    <!-- 発行のプロファイル名 (PublishProfile)は Server のものなので、Client には渡さない (渡すと、Client に同名のプロファイルが無いという警告が出る) -->
    <ProjectReference Include="..\Client\MmmToolWeb.Client.csproj" GlobalPropertiesToRemove="PublishProfile" />
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.Features\MmmToolWeb.Features.csproj" />
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.Messages\MmmToolWeb.Messages.csproj" />
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.Notifications\MmmToolWeb.Notifications.csproj" />
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.Reminders\MmmToolWeb.Reminders.csproj" />
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.Notes\MmmToolWeb.Notes.csproj" />
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.WorkItems\MmmToolWeb.WorkItems.csproj" />
    <ProjectReference Include="..\..\..\Auth\MmmToolWeb.Auth.Core\MmmToolWeb.Auth.Core.csproj" />
    <ProjectReference Include="..\..\..\Data\MmmToolWeb.Data.SqlServer\MmmToolWeb.Data.SqlServer.csproj" />
  </ItemGroup>

  <!-- ビルドの出力と配布物の作り方 (Lib への移動・ライセンス全文・発行の設定)は MmmTool・MmmBatch と共通 -->
  <Import Project="..\..\..\..\build\AppDistribution.targets" />
</Project>
