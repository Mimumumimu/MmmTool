<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ブラウザ (browser-wasm)で動くので、x64 専用の共通設定 (Directory.Build.props)から外す。WebAssembly は PlatformTarget x64 と両立しない -->
    <Platforms>AnyCPU</Platforms>
    <Platform>AnyCPU</Platform>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.Features.Client\MmmToolWeb.Features.Client.csproj" />
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.Messages.Client\MmmToolWeb.Messages.Client.csproj" />
    <ProjectReference Include="..\..\..\Plugins\MmmToolWeb.Notes.Client\MmmToolWeb.Notes.Client.csproj" />
  </ItemGroup>

</Project>
