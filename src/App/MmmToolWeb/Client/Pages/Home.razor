@page "/"
@using MmmToolWeb.Client.Auth
@inject AuthClient Auth
@inject PasskeyBrowser Passkeys
@inject NavigationManager Navigation

<main class="page">
    <h1>MmmTool</h1>
    <p class="lead">パスキーでログインします。</p>

    @if (_loading || _me is not null)
    {
        <p>確認しています。</p>
    }
    else
    {
        @if (UnavailableReason is not null)
        {
            <p class="notice" role="status">@UnavailableReason</p>
        }

        <button type="button" class="primary" @onclick="LoginAsync" disabled="@_busy">パスキーでログイン</button>

        <section class="enroll">
            <h2>この端末のパスキーを登録</h2>
            <p class="hint">管理者から受け取った 8 桁のコードを入れます。</p>
            <label>
                登録用コード
                <input type="text" inputmode="numeric" autocomplete="off" @bind="_code" @bind:event="oninput" />
            </label>
            <button type="button" @onclick="EnrollAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_code))">登録</button>
        </section>

#if DEBUG
        <section class="enroll">
            <h2>開発用ログイン (Debug のみ)</h2>
            <label>
                ログイン名
                <input type="text" autocomplete="off" autocapitalize="off" spellcheck="false" @bind="_devLoginName" @bind:event="oninput" />
            </label>
            <button type="button" @onclick="DevLoginAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_devLoginName))">ログイン</button>
        </section>
#endif
    }

    @if (_message is not null)
    {
        <p class="message" role="alert">@_message</p>
    }
</main>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _needsHomeScreen;
    private bool _supported;
    private string _code = string.Empty;
    private string? _message;
    private MeResponse? _me;
#if DEBUG
    private string _devLoginName = string.Empty;
#endif

    /// <summary>パスキーを使えない理由。使えるときは <c>null</c>。ブラウザが対応していないときを先に出す。ホーム画面の案内は、iPhone と iPad だけに出す。</summary>
    private string? UnavailableReason => !_supported
        ? "このブラウザではパスキーを使えません。"
        : _needsHomeScreen ? "ホーム画面に追加したアプリから開いてください。" : null;

    protected override async Task OnInitializedAsync()
    {
        _needsHomeScreen = await Passkeys.NeedsHomeScreenAsync();
        _supported = await Passkeys.IsSupportedAsync();
        _me = await Auth.GetMeAsync();
        _loading = false;
        GoToHome();
    }

    /// <summary>ログインしていれば、ホーム画面へ移る。</summary>
    private void GoToHome()
    {
        if (_me is not null)
        {
            Navigation.NavigateTo(FeatureHeader.HomePath, replace: true);
        }
    }

    private Task LoginAsync() => RunAsync(Auth.LoginAsync);

    private Task EnrollAsync() => RunAsync(() => Auth.EnrollAsync(_code.Trim()));

#if DEBUG
    private Task DevLoginAsync() => RunAsync(() => Auth.DevLoginAsync(_devLoginName.Trim()));

#endif
    private async Task RunAsync(Func<Task<AuthResult>> action)
    {
        _busy = true;
        _message = null;
        var result = await action();
        if (result.Succeeded)
        {
            _me = await Auth.GetMeAsync();
            GoToHome();
        }
        else
        {
            _message = result.Message;
        }
        _busy = false;
    }
}
