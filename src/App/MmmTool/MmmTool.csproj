<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MmmTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Debug は黄色のアイコン (トレイで普段使いの Release と見分けるため) -->
    <ApplicationIcon Condition="'$(Configuration)' == 'Debug'">Assets\app-debug.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(Configuration)' != 'Debug'">Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!--
      ビルドも x64 専用にする。ネイティブ DLL が全 CPU 分の runtimes フォルダーではなく、EXE の横に x64 の分だけ置かれる。
      出力先のパスには RID を付けない (Directory.Build.props の AppendRuntimeIdentifierToOutputPath。bin\<構成>\<TFM>\ のまま)。理由は docs/build-and-distribution.md の「決定の理由」
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- 非パッケージ (WindowsPackageType=None)でも、WinUI のリソース (resources.pri)の生成にこの MSIX ツールを使うため、true のままにする -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- ランタイム (Windows App Runtime / .NET)は PC 側にインストールする前提。出力の DLL の数を減らすため (単一ファイルにはしない。理由は docs/build-and-distribution.md の「決定の理由」) -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <!-- 言語別リソース (NuGet 由来のサテライト DLL)を日本語・英語だけにする -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- アプリのアイコン (EXE に埋め込むほか、トレイ・ウィンドウのアイコンとして実行時にファイルから読む) -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' != 'Debug'" />
    <!-- Debug は、出力では同じ名前 (Assets\app.ico)にして、AppIcon.cs を切り替えずに済ませる -->
    <Content Include="Assets\app-debug.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配布用の説明書 (変更履歴を含む)。発行のときだけ、アプリ本体の外側の版のフォルダに置く (下の PackageDistribution。ビルドの出力には入れない)
    -->
    <DistributionDocument Include="Distribution\README.txt" />
    <!--
      ライセンス (MIT License の本文。ライセンスの条件として、配布物に入れる)。アプリ本体の Assets\Licenses に置く。
      アプリ本体だけをコピー・再配布されても、ライセンスが一緒に付いていくようにするため (EXE の横は増やさない)。
      同梱ライブラリのライセンス全文 (THIRD-PARTY-NOTICES.txt)も、下の GenerateThirdPartyNotices が作って同じ場所に置く
    -->
    <None Include="..\..\..\LICENSE.txt" Link="Assets\Licenses\LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    DEBUG ページ (開発用)は、リリースビルドには含めない (コード・XAML ごとビルドから外す)。
    XAML は #if DEBUG で囲めないため、ここで外す。DI への登録 (DebuggingServiceCollectionExtensions)は #if DEBUG で何も登録しない。
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="Features\Debugging\Main\DebugPage.xaml" />
    <Compile Remove="Features\Debugging\Main\DebugPage.xaml.cs" />
    <Compile Remove="Features\Debugging\Main\DebugViewModel.cs" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!--
      Windows App SDK は全部入りのパッケージを参照する (CommunityToolkit が古い全部入り 1.6 に依存しているため、部品だけの参照にはできない)。
      そのうえで、使わない部品 (AI・ML・検索・ウィジェット)と、それらだけが使う依存 (MachineLearning・Tensors)は、中身を出力に入れない (DLL を減らすため。理由は docs/build-and-distribution.md の「決定の理由」)
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Plugins\MmmTool.Links\MmmTool.Links.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.WorkItems\MmmTool.WorkItems.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.Backlog\MmmTool.Backlog.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.ClipboardTransfer\MmmTool.ClipboardTransfer.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.Reminders\MmmTool.Reminders.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.CliAssist\MmmTool.CliAssist.csproj" />
    <ProjectReference Include="..\..\Data\MmmTool.Data.SqlServer\MmmTool.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\Data\MmmTool.Data.SqlServer.WinUI\MmmTool.Data.SqlServer.WinUI.csproj" />
    <ProjectReference Include="..\..\..\external\MmmSdk\MmmSdk.WinUI\MmmSdk.WinUI.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Windows App SDK が出力へコピーする WinUI の多言語リソース (言語名フォルダ内の .mui)のうち、
    日本語・英語以外を削除する。SatelliteResourceLanguages では消えないため。
  -->
  <Target Name="PruneMuiAfterBuild" AfterTargets="Build">
    <ItemGroup>
      <_MuiBuild Include="$(OutDir)*\*.mui" Exclude="$(OutDir)ja-JP\*.mui;$(OutDir)en-us\*.mui" />
      <_MuiBuildDir Include="@(_MuiBuild->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Delete Files="@(_MuiBuild)" />
    <RemoveDir Directories="@(_MuiBuildDir-&gt;Distinct())" />
  </Target>
  <!--
    ビルドの出力から、画面の XAML (.xbf・SDK の .xaml)のばらのファイルを削除する (Features・Shell・MmmSdk.WinUI フォルダーを残さない)。
    中身は MmmTool.pri に入っていて、実行時はそちらから読む。WinUI のビルド (CopyGeneratedXaml)は、.pri に入れたうえで、ばらのファイルも出力へコピーするため。
    発行 (publish)の出力には、もともとばらのファイルが出ない。ここで消すことで、ビルドの出力を発行物と同じ形にそろえる。理由は docs/build-and-distribution.md の「決定の理由」
    消すのは、EXE の横の .xbf と、中身が .xbf・.xaml だけのフォルダー (Assets・Data のように、ほかのファイルがあるフォルダーには触れない)。
  -->
  <Target Name="RemoveLooseXamlAfterBuild" AfterTargets="Build">
    <ItemGroup>
      <_OutSubDir Include="$([System.IO.Directory]::GetDirectories('$(OutDir)'))" />
      <_LooseXamlDir Include="@(_OutSubDir)"
                     Condition="$([System.IO.Directory]::GetFiles('%(Identity)', '*', System.IO.SearchOption.AllDirectories).Length) == $([MSBuild]::Add($([System.IO.Directory]::GetFiles('%(Identity)', '*.xbf', System.IO.SearchOption.AllDirectories).Length), $([System.IO.Directory]::GetFiles('%(Identity)', '*.xaml', System.IO.SearchOption.AllDirectories).Length))) and $([System.IO.Directory]::GetFiles('%(Identity)', '*', System.IO.SearchOption.AllDirectories).Length) &gt; 0" />
      <_LooseXbf Include="$(OutDir)*.xbf" />
    </ItemGroup>
    <Delete Files="@(_LooseXbf)" />
    <RemoveDir Directories="@(_LooseXamlDir)" />
  </Target>
  <Target Name="PruneMuiAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <_MuiPub Include="$(PublishDir)*\*.mui" Exclude="$(PublishDir)ja-JP\*.mui;$(PublishDir)en-us\*.mui" />
      <_MuiPubDir Include="@(_MuiPub->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Delete Files="@(_MuiPub)" />
    <RemoveDir Directories="@(_MuiPubDir-&gt;Distinct())" />
  </Target>

  <!--
    NuGet パッケージの DLL (マネージド・ネイティブ)を、EXE の横ではなく Lib フォルダーに置く (理由は docs/build-and-distribution.md の「決定の理由」)。
    置き場所は、コピー先 (DestinationSubPath)を Lib\ に変えて決める。ビルド・発行のどちらのコピーも、これに従う。
    起動時に .NET が DLL を見つけられるよう、MmmTool.deps.json の各ファイルに localPath (実際の置き場所)を書き足す (.NET SDK には、これを書く設定が無いため)。
    パッケージ以外の参照・Windows SDK と WinRT の DLL も、下の MoveReferencesToLib・MoveRuntimePackFilesToLib で Lib に置く。EXE の横に残る DLL は MmmTool.dll と Microsoft.Web.WebView2.Core.dll だけ。
  -->
  <PropertyGroup>
    <PackageFilesFolder>Lib</PackageFilesFolder>
  </PropertyGroup>
  <Target Name="MovePackageFilesToLib" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems DestinationSubDirectory="$(PackageFilesFolder)\" DestinationSubPath="$(PackageFilesFolder)\%(Filename)%(Extension)" />
      <NativeCopyLocalItems DestinationSubDirectory="$(PackageFilesFolder)\" DestinationSubPath="$(PackageFilesFolder)\%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
  <!--
    パッケージの言語別リソース (日本語などの衛星アセンブリ。例: ja\Microsoft.Data.SqlClient.resources.dll)も、EXE の横の言語フォルダーではなく Lib の中 (Lib\ja\)に置く。
    deps.json の resources の項目にも localPath を書く (下の MoveReferencesToLib が _FilesInLib に集める)。.NET はそれを見て Lib\ja\ から読む。
  -->
  <Target Name="MoveSatellitesToLib" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResourceCopyLocalItems DestinationSubDirectory="$(PackageFilesFolder)\%(ResourceCopyLocalItems.DestinationSubDirectory)" DestinationSubPath="$(PackageFilesFolder)\%(ResourceCopyLocalItems.DestinationSubPath)" />
    </ItemGroup>
  </Target>
  <!--
    パッケージ以外の参照 (自分のプロジェクト・Windows SDK・WinRT・WebView2 の参照用)も Lib に置く。プロジェクトの .pri など、付随するファイルも一緒に移る。
    Microsoft.Web.WebView2.Core.dll は EXE の横に残す (deps.json に載らないネイティブの部品で、WinUI の WebView2 が EXE のフォルダーから読むため)。
  -->
  <!-- 発行では、Windows SDK・WinRT の DLL (ランタイムパックの分)は、別の経路 (RuntimePackAsset)でコピーされるので、そちらのコピー先も Lib にする -->
  <Target Name="MoveRuntimePackFilesToLib" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <RuntimePackAsset DestinationSubPath="$(PackageFilesFolder)\%(RuntimePackAsset.Filename)%(RuntimePackAsset.Extension)"
                        DestinationSubDirectory="$(PackageFilesFolder)\"
                        Condition="'%(RuntimePackAsset.RuntimePackAlwaysCopyLocal)' == 'true' and '%(RuntimePackAsset.DestinationSubPath)' == '%(RuntimePackAsset.Filename)%(RuntimePackAsset.Extension)'" />
    </ItemGroup>
  </Target>
  <Target Name="MoveReferencesToLib" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths DestinationSubDirectory="$(PackageFilesFolder)\"
                               Condition="'%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == '' and '%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' != 'Microsoft.Web.WebView2.Core.dll'" />
      <_FilesInLib Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == '$(PackageFilesFolder)\' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <_FilesInLib Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.DestinationSubDirectory)' != '$(PackageFilesFolder)\' and $([System.String]::Copy('%(ReferenceCopyLocalPaths.DestinationSubDirectory)').StartsWith('$(PackageFilesFolder)\')) and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>
  <Target Name="AddLocalPathToBuildDepsFile" AfterTargets="CopyFilesToOutputDirectory">
    <AddLocalPathToDepsFile DepsFile="$(ProjectDepsFilePath)" Files="@(_FilesInLib)" />
  </Target>
  <!-- 発行の deps.json は、ビルドのものを写すときと、作り直すときがあるので、発行の出力に置かれたものに足す -->
  <Target Name="AddLocalPathToPublishDepsFile" AfterTargets="Publish">
    <AddLocalPathToDepsFile DepsFile="$(PublishDir)$(ProjectDepsFileName)" Files="@(_FilesInLib)" />
  </Target>
  <!--
    deps.json の、ファイルごとの項目 ("…/名前.dll": { … })に "localPath": "Lib/名前.dll" を足す。
    deps.json は .NET SDK が決まった形で書くので、ファイル名をキーにして文字列で足す (すでに足してあれば何もしない)。
  -->
  <UsingTask TaskName="AddLocalPathToDepsFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <DepsFile ParameterType="System.String" Required="true" />
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = File.ReadAllText(DepsFile);
        foreach (var file in Files)
        {
            var localPath = (file.GetMetadata("DestinationSubDirectory") + file.GetMetadata("Filename") + file.GetMetadata("Extension")).Replace('\\', '/');
            var key = "(\"(?:[^\"/]*/)*" + Regex.Escape(Path.GetFileName(localPath)) + "\": \\{)";
            // 中身が空の項目 ({})と、中身がある項目 ({ "assemblyVersion": … })
            text = Regex.Replace(text, key + "\\}", "$1 \"localPath\": \"" + localPath + "\" }");
            text = Regex.Replace(text, key + "(?!\\s*\"localPath\")(?=\\s*\")", "$1\n            \"localPath\": \"" + localPath + "\",");
        }
        File.WriteAllText(DepsFile, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    発行 (配布物)は、全プロジェクトを Release でビルドしたものだけにする (Debug の DLL・.pdb を配布物に入れないため)。
    構成は、全プロジェクトに渡る形 (VS の「発行」・dotnet publish・-p:Configuration=Release)で指定する。
    発行プロファイルの Configuration だけに頼る呼び方 (MSBuild を直接呼ぶなど)では、このプロジェクトにしか効かず、
    参照先が Debug でビルドされ、Directory.Build.props の Release の設定 (.pdb を作らない)も効かないので、エラーで止める。
    DebugType が none でないことで、Directory.Build.props の評価のときに Release ではなかったことを見分ける
  -->
  <Target Name="EnsureReleaseForPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(Configuration)' != 'Release' or '$(DebugType)' != 'none'"
           Text="発行は Release でだけ行います。VS の「発行」か、dotnet publish .\src\App\MmmTool\MmmTool.csproj -p:PublishProfile=win-x64 で発行してください (MSBuild を直接呼ぶときは -p:Configuration=Release も付ける)。" />
  </Target>

  <!--
    同梱しているライブラリのライセンス全文 (THIRD-PARTY-NOTICES.txt)を、発行のたびに、実際に配布物へ入るファイルから作って、アプリ本体の Assets\Licenses に置く。
    手で書くと、パッケージを足したり版を上げたりしたときに中身がずれるため、発行するファイルの一覧 (ResolvedFileToPublish)から作る。
    - NuGet パッケージ: パッケージの中のライセンスファイル (無ければ、MIT なら nuspec の著作権表示で本文を作る)と、第三者の通知 (NOTICE・ThirdPartyNotices)
    - パッケージ以外: 配布物の中の「名前.LICENSE.txt」 (xterm.js など)
    中身が同じものは 1 つにまとめ、対象の名前を並べる
  -->
  <Target Name="GenerateThirdPartyNotices" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_ThirdPartyNoticesPath>$(IntermediateOutputPath)THIRD-PARTY-NOTICES.txt</_ThirdPartyNoticesPath>
    </PropertyGroup>
    <GenerateThirdPartyNoticesFile Files="@(ResolvedFileToPublish)" PackageRoot="$(NuGetPackageRoot)" OutputFile="$(_ThirdPartyNoticesPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_ThirdPartyNoticesPath)" RelativePath="Assets\Licenses\THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="Always" />
      <FileWrites Include="$(_ThirdPartyNoticesPath)" />
    </ItemGroup>
  </Target>
  <!--
    発行のあとに、配布物を作る (ユーザーの決定)。
      bin\<構成>\publish\MmmTool_<版>\     版のフォルダ (版は Directory.Build.props の Version)。説明書とアプリ本体だけを並べる
        README.txt
        MmmTool\                           アプリ本体 (発行の出力をそのまま写す)。コピー先のフォルダ名が版ごとに変わらない
    発行の出力先 (PublishDir)は、発行プロファイルで版を含まない途中のフォルダ (obj\<構成>\publish\)にしている。
    VS の「発行」はプロファイルを単体で読むので、プロファイルではプロジェクトの Version を使えないため、版を付けるのはここで行う。
    発行の出力を直す処理 (.mui の削除・deps.json の localPath)が済んでから写す
  -->
  <PropertyGroup>
    <DistributionDir Condition="'$(DistributionDir)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\publish\MmmTool_$(Version)\</DistributionDir>
  </PropertyGroup>
  <Target Name="PackageDistribution" AfterTargets="Publish" DependsOnTargets="PruneMuiAfterPublish;AddLocalPathToPublishDepsFile">
    <ItemGroup>
      <_PublishedFile Include="$(PublishDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedFile)" DestinationFiles="@(_PublishedFile->'$(DistributionDir)MmmTool\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DistributionDocument)" DestinationFolder="$(DistributionDir)" />
    <Message Importance="high" Text="$(MSBuildProjectName) の配布物 -> $(DistributionDir)" />
  </Target>
  <UsingTask TaskName="GenerateThirdPartyNoticesFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <PackageRoot ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string MitTemplate =
            "MIT License\n\n{0}\n\n" +
            "Permission is hereby granted, free of charge, to any person obtaining a copy\n" +
            "of this software and associated documentation files (the \"Software\"), to deal\n" +
            "in the Software without restriction, including without limitation the rights\n" +
            "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n" +
            "copies of the Software, and to permit persons to whom the Software is\n" +
            "furnished to do so, subject to the following conditions:\n\n" +
            "The above copyright notice and this permission notice shall be included in all\n" +
            "copies or substantial portions of the Software.\n\n" +
            "THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n" +
            "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n" +
            "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n" +
            "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n" +
            "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n" +
            "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n" +
            "SOFTWARE.\n";

        Func<string, string> normalize = s => s.Replace("\r\n", "\n").Replace("\r", "\n").Trim('\n', ' ', '﻿');

        // 発行するファイルから、パッケージ (名前 → 版)と、パッケージ以外のライセンスファイルを集める
        var packages = new SortedDictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var looseLicenses = new SortedDictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var file in Files)
        {
            var id = file.GetMetadata("NuGetPackageId");
            // 自分のプロジェクト (機能のライブラリ・MmmSdk)もパッケージ名を持つが、ライセンスは LICENSE.txt なので含めない
            if (file.GetMetadata("ReferenceSourceTarget") == "ProjectReference") continue;
            if (id.Length > 0)
            {
                packages[id] = file.GetMetadata("NuGetPackageVersion");
            }
            else if (file.GetMetadata("Filename").EndsWith(".LICENSE", StringComparison.OrdinalIgnoreCase))
            {
                var name = file.GetMetadata("Filename");
                looseLicenses[name.Substring(0, name.Length - ".LICENSE".Length)] = file.ItemSpec;
            }
        }

        // ライセンスの本文ごとに、対象の名前をまとめる (本文 → 名前の一覧)
        var groups = new Dictionary<string, List<string>>();
        Action<string, string> add = (text, name) =>
        {
            text = normalize(text);
            if (!groups.TryGetValue(text, out var names)) groups[text] = names = new List<string>();
            names.Add(name);
        };

        foreach (var package in packages)
        {
            var directory = Path.Combine(PackageRoot, package.Key.ToLowerInvariant(), package.Value.ToLowerInvariant());
            if (!Directory.Exists(directory))
            {
                Log.LogError("THIRD-PARTY-NOTICES: パッケージ " + package.Key + " " + package.Value + " のフォルダーが見つかりません (" + directory + ")。");
                return false;
            }
            var nuspec = XDocument.Load(Directory.GetFiles(directory, "*.nuspec").First());
            Func<string, XElement> element = localName => nuspec.Descendants().FirstOrDefault(e => e.Name.LocalName == localName);
            var license = element("license");
            var copyright = element("copyright")?.Value.Trim() ?? "";
            var rootFiles = Directory.GetFiles(directory);

            var parts = new List<string>();
            if (license?.Attribute("type")?.Value == "file")
            {
                parts.Add(File.ReadAllText(Path.Combine(directory, license.Value)));
            }
            else
            {
                var licenseFile = rootFiles.FirstOrDefault(f => Path.GetFileName(f).StartsWith("license", StringComparison.OrdinalIgnoreCase));
                if (licenseFile != null)
                    parts.Add(File.ReadAllText(licenseFile));
                else if (license?.Value == "MIT")
                    parts.Add(string.Format(MitTemplate, copyright));
                else
                    parts.Add("License: " + (license?.Value ?? element("licenseUrl")?.Value ?? "(not specified)") + (copyright.Length > 0 ? "\n" + copyright : ""));
            }
            foreach (var notice in rootFiles.Where(f => Path.GetFileName(f).IndexOf("notice", StringComparison.OrdinalIgnoreCase) >= 0).OrderBy(f => f, StringComparer.OrdinalIgnoreCase))
            {
                parts.Add(File.ReadAllText(notice));
            }
            add(string.Join("\n\n", parts.Select(normalize)), package.Key + " " + package.Value);
        }
        foreach (var loose in looseLicenses)
        {
            add(File.ReadAllText(loose.Value), loose.Key);
        }

        var output = new StringBuilder();
        output.Append("THIRD-PARTY NOTICES\n\n");
        output.Append("MmmTool に同梱しているソフトウェアと、そのライセンス・通知の全文です (発行のときに自動で作っています)。\n");
        output.Append("This file lists the third-party software included with MmmTool and their licenses and notices.\n");
        foreach (var group in groups.OrderBy(g => g.Value[0], StringComparer.OrdinalIgnoreCase))
        {
            output.Append("\n\n").Append(new string('=', 78)).Append('\n');
            foreach (var name in group.Value) output.Append(name).Append('\n');
            output.Append(new string('=', 78)).Append("\n\n");
            output.Append(group.Key).Append('\n');
        }

        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        File.WriteAllText(OutputFile, output.ToString().Replace("\n", "\r\n"), new UTF8Encoding(true));
      ]]></Code>
    </Task>
  </UsingTask>

