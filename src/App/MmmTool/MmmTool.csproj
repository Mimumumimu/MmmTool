<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MmmTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Debug は黄色のアイコン (トレイで普段使いの Release と見分けるため) -->
    <ApplicationIcon Condition="'$(Configuration)' == 'Debug'">Assets\app-debug.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(Configuration)' != 'Debug'">Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!--
      ビルドも x64 専用にする。ネイティブ DLL が全 CPU 分の runtimes フォルダーではなく、EXE の横に x64 の分だけ置かれる。
      出力先のパスには RID を付けない (Directory.Build.props の AppendRuntimeIdentifierToOutputPath。bin\<構成>\<TFM>\ のまま)。理由は docs/build-and-distribution.md の「決定の理由」
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- 非パッケージ (WindowsPackageType=None)でも、WinUI のリソース (resources.pri)の生成にこの MSIX ツールを使うため、true のままにする -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- ランタイム (Windows App Runtime / .NET)は PC 側にインストールする前提。ランタイムを同梱して出力の容量を大きくしないため (単一ファイルにはしない。理由は docs/build-and-distribution.md の「決定の理由」) -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <!-- 言語別リソース (NuGet 由来のサテライト DLL)を日本語・英語だけにする -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- アプリのアイコン (EXE に埋め込むほか、トレイ・ウィンドウのアイコンとして実行時にファイルから読む) -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' != 'Debug'" />
    <!-- Debug は、出力では同じ名前 (Assets\app.ico)にして、AppIcon.cs を切り替えずに済ませる -->
    <Content Include="Assets\app-debug.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配布用の説明書 (README.txt は変更履歴を含む。操作説明.html は機能ごとの使い方)。発行のときだけ、アプリ本体と同じ版のフォルダに置く (下の PackageDistribution。ビルドの出力には入れない)
    -->
    <DistributionDocument Include="Distribution\README.txt" />
    <DistributionDocument Include="Distribution\操作説明.html" />
    <!--
      ライセンス (MIT License の本文。ライセンスの条件として、配布物に入れる)。アプリ本体の Assets\Licenses に置く。
      アプリ本体だけをコピー・再配布されても、ライセンスが一緒に付いていくようにするため (EXE の横は増やさない)。
      同梱ライブラリのライセンス全文 (THIRD-PARTY-NOTICES.txt)も、下の GenerateThirdPartyNotices が作って同じ場所に置く
    -->
    <None Include="..\..\..\LICENSE.txt" Link="Assets\Licenses\LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 配布物のフォルダ名 (版は Directory.Build.props の Version) -->
    <DistributionFolderName>MmmTool_$(Version)</DistributionFolderName>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    DEBUG ページ (開発用)は、リリースビルドには含めない (コード・XAML ごとビルドから外す)。
    XAML は #if DEBUG で囲めないため、ここで外す。DI への登録 (DebuggingServiceCollectionExtensions)は #if DEBUG で何も登録しない。
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="Features\Debugging\Main\DebugPage.xaml" />
    <Compile Remove="Features\Debugging\Main\DebugPage.xaml.cs" />
    <Compile Remove="Features\Debugging\Main\DebugViewModel.cs" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!--
      Windows App SDK は全部入りのパッケージを参照する (CommunityToolkit が古い全部入り 1.6 に依存しているため、部品だけの参照にはできない)。
      そのうえで、使わない部品 (AI・ML・検索・ウィジェット)と、それらだけが使う依存 (MachineLearning・Tensors)は、中身を出力に入れない (DLL を減らすため。理由は docs/build-and-distribution.md の「決定の理由」)
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Plugins\MmmTool.Links\MmmTool.Links.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.WorkItems\MmmTool.WorkItems.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.Backlog\MmmTool.Backlog.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.ClipboardTransfer\MmmTool.ClipboardTransfer.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.Reminders\MmmTool.Reminders.csproj" />
    <ProjectReference Include="..\..\Plugins\MmmTool.CliAssist\MmmTool.CliAssist.csproj" />
    <ProjectReference Include="..\..\Data\MmmTool.Data.Sqlite\MmmTool.Data.Sqlite.csproj" />
    <ProjectReference Include="..\..\Data\MmmTool.Data.SqlServer\MmmTool.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\Data\MmmTool.Data.SqlServer.WinUI\MmmTool.Data.SqlServer.WinUI.csproj" />
    <ProjectReference Include="..\..\..\external\MmmSdk\MmmSdk.WinUI\MmmSdk.WinUI.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- ビルドの出力と配布物の作り方 (Lib への移動・ライセンス全文・版のフォルダ)は MmmBatch と共通 -->
  <Import Project="..\..\..\build\AppDistribution.targets" />
</Project>