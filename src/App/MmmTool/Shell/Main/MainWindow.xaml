<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Shell.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:MmmSdk.WinUI.Components.Pages"
    Title="MmmTool">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="TitleBarButtons" Margin="4,0,0,0" Orientation="Horizontal">
                    <pages:NavigationPaneToggleButton x:Name="PaneToggleButton" />
                    <pages:NavigationHistoryButtons x:Name="HistoryButtons" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="MmmTool" />
            </StackPanel>
        </Grid>

        <!-- サイドバーと、選んだ項目のページで、SDK の NavigationHost。コードで入れる -->
        <Border x:Name="ContentHost" Grid.Row="1" />
    </Grid>
</Window>
