<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.Features.Debugging.Main.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="DEBUG" />
        <Button Command="{x:Bind ViewModel.ShowNotificationCommand}" Content="通知ダイアログを表示" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.NewReminderCommand}" Content="リマインダー入力 (新規)" />
            <Button Command="{x:Bind ViewModel.EditFirstReminderCommand}" Content="リマインダー編集 (最初の 1 件)" />
            <Button Command="{x:Bind ViewModel.ShowReminderListCommand}" Content="リマインダー一覧" />
        </StackPanel>
    </StackPanel>
</Page>
