<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Features.Users.Edit.AccountEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Heading, Mode=OneWay}" />
        </Grid>

        <!-- 入力欄 (項目に合わせて出し分ける) -->
        <StackPanel
            Grid.Row="1"
            Padding="24,16,24,0"
            Spacing="12">

            <TextBox
                x:Name="ValueBox"
                GotFocus="OnValueBoxGotFocus"
                Header="{x:Bind ViewModel.ValueHeader, Mode=OneWay}"
                MaxLength="{x:Bind ViewModel.ValueMaxLength, Mode=OneWay}"
                Text="{x:Bind ViewModel.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.ShowValue, Mode=OneWay}" />

            <PasswordBox
                x:Name="CurrentPasswordBox"
                Header="現在のパスワード"
                Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.NeedsCurrentPassword, Mode=OneWay}" />

            <PasswordBox
                Header="新しいパスワード"
                Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsPassword, Mode=OneWay}" />

            <PasswordBox
                Header="新しいパスワード (確認)"
                Password="{x:Bind ViewModel.NewPasswordConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsPassword, Mode=OneWay}" />

            <!-- エラー。行は場所を空けておく (出たり消えたりで下が動かないように) -->
            <TextBlock
                MinHeight="16"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 操作ボタン (肯定を左・キャンセルを右に) -->
        <StackPanel
            Grid.Row="2"
            Padding="24,12,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="保存"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="キャンセル" />
        </StackPanel>

        <!-- 保存先 (DB)の失敗。レイアウトに場所を取らず、入力欄の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.SaveError.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SaveError.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
