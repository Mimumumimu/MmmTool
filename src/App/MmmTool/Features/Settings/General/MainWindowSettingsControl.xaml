<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Features.Settings.General.MainWindowSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="4">
        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="全般" />

        <!-- 保存に失敗したとき (閉じている間は、Spacing の分の場所も取らない) -->
        <InfoBar
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />

        <controls:SettingsCard Header="起動時にメイン画面を開く">
            <ToggleSwitch
                IsEnabled="{x:Bind ViewModel.IsEditable}"
                IsOn="{x:Bind ViewModel.OpenOnStartup, Mode=TwoWay}"
                OffContent="オフ"
                OnContent="オン" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="無音を流し続けて、音声機器が休止するのを防ぎます。通知の読み上げの頭が切れるときに、オンにします。"
            Header="音声機器を起こしておく">
            <ToggleSwitch
                IsEnabled="{x:Bind ViewModel.IsEditable}"
                IsOn="{x:Bind ViewModel.KeepAudioDeviceAwake, Mode=TwoWay}"
                OffContent="オフ"
                OnContent="オン" />
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
