<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Features.Database.Settings.DatabaseSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="4">
        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="保存先" />

        <!-- カード全体を押すと、編集画面が開く (保存は、編集画面の「保存」) -->
        <controls:SettingsCard
            Command="{x:Bind ViewModel.OpenCommand}"
            Description="{x:Bind ViewModel.Summary, Mode=OneWay}"
            Header="保存先"
            IsClickEnabled="True"
            IsEnabled="{x:Bind ViewModel.IsEditable}" />
    </StackPanel>
</UserControl>
