<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MmmTool.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool"
    xmlns:sdk="using:MmmSdk.WinUI.Components.DaysOfWeek">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- アプリ共通のスタイル。XamlControlsResources の後ろに置く -->
                <ResourceDictionary Source="ms-appx:///MmmSdk.WinUI/Controls/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 日付の選択欄のカレンダーは、日の下に、土曜は青、日曜と祝日は赤の線を付ける。選択欄ごとには指定せず、既定のスタイルで全体に効かせる。独自のスタイルを付ける CalendarDatePicker は、AppCalendarDatePickerStyle を BasedOn にする。このスタイル自体には BasedOn を付けない (DefaultCalendarDatePickerStyle というキーは WinUI に無く、付けると起動時に落ちる) -->
            <Style x:Key="AppCalendarDatePickerStyle" TargetType="CalendarDatePicker">
                <Setter Property="sdk:CalendarHolidayColoring.IsEnabled" Value="True" />
            </Style>
            <Style TargetType="CalendarDatePicker" BasedOn="{StaticResource AppCalendarDatePickerStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
