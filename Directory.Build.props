<Project>
  <!--
    アプリの全プロジェクト共通の設定。プロジェクト固有の設定 (対象フレームワーク・WinUI 等)は各 csproj に書く。
    サブモジュールの MmmSdk は自分の Directory.Build.props を使う。MSBuild は近いほうを使うので、ここの設定は SDK に届かない。
  -->
  <PropertyGroup>
    <!-- 製品のバージョンで、形は major.minor.patch。ファイル・アセンブリのバージョンはここから自動で 4 桁になる -->
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML ドキュメントコメントの検査で、書き漏れ・参照切れを警告にする。未使用 using の検査 (IDE0005)にも必要 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- .editorconfig のコードスタイルをビルド時にも検査する -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- 検査用に作る XML ファイルは配布物に含めない (配布物のファイル数を増やさないため) -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!--
      XML ファイルは、検査のために obj には作るが、ビルドの出力にもコピーしない。実行には使わないためで、理由は docs/build-and-distribution.md の「決定の理由」にある。
      参照先 (SDK)の XML ファイルもコピーしない (参照先の付随ファイルの既定 .pdb;.xml;.pri;.dll.config;.exe.config から .xml を外す)
    -->
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <AllowedReferenceRelatedFileExtensions>.pdb;.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
    <!--
      既定は x64 専用にする。SDK も同じ設定。
      ブラウザで動く Web 版の画面側と、それが参照するライブラリは、csproj の Platforms・Platform・PlatformTarget を AnyCPU にして、この既定から外す。
      外すのは、MmmToolWeb の画面側と、各機能の .Core と、MmmSdk.Core など。ブラウザの実行環境は browser-wasm。AnyCPU のプロジェクトは、.slnx には、プラットフォームを書かずに登録する。
      Platforms は VS で選べる一覧なので、既定の Platform も x64 にする (-p:Platform を付けないビルド・発行で AnyCPU にならないように)
    -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <!-- プラットフォームは x64 だけなので、出力先 (bin・obj)に x64 の段を作らない。出力先は bin\<構成>\<TFM>\ で、配布物は bin\Release\publish\MmmTool_<版>\ -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <!--
      RID も win-x64 だけなので、出力先に RID の段を作らない。SDK も同じ設定にしている。
      VS の「発行」は RID を参照先にも渡すので、段を作ると、RID の有無で出力先が変わり、先にビルドした DLL を見つけられずに失敗する
    -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <!--
    Release では .pdb (デバッグ情報)を作らず、参照先 (SDK)の .pdb も出力へコピーしない。ユーザーの決定で、Debug では作る。理由は docs/build-and-distribution.md の「決定の理由」
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
