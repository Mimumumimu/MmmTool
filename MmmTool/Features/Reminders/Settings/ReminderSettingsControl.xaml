<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Features.Reminders.Settings.ReminderSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <!-- 保存に失敗したとき -->
        <InfoBar
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock VerticalAlignment="Center" Text="リマインダーのスヌーズ間隔 (分)" />
            <NumberBox
                Width="160"
                GotFocus="OnNumberBoxGotFocus"
                IsEnabled="{x:Bind ViewModel.IsEditable}"
                Loaded="OnNumberBoxLoaded"
                LargeChange="10"
                Maximum="{x:Bind ViewModel.SnoozeIntervalMax}"
                Minimum="{x:Bind ViewModel.SnoozeIntervalMin}"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.SnoozeIntervalMinutes, Mode=TwoWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
