<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Features.Database.Settings.DatabaseSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <!-- 保存・接続の確認の結果 (閉じている間は、Spacing の分の場所も取らない) -->
        <InfoBar
            IsOpen="{x:Bind ViewModel.Connection.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Connection.Error.Message, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.Connection.Error.IsOpen, Mode=OneWay}" />
        <InfoBar
            IsOpen="{x:Bind ViewModel.Connection.Success.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Connection.Success.Message, Mode=OneWay}"
            Severity="Success"
            Visibility="{x:Bind ViewModel.Connection.Success.IsOpen, Mode=OneWay}" />

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SettingNameColumnWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="保存先" />
            <ComboBox
                Grid.Column="1"
                MinWidth="260"
                DisplayMemberPath="Name"
                IsEnabled="{x:Bind ViewModel.IsEditable}"
                ItemsSource="{x:Bind ViewModel.Modes}"
                SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />
        </Grid>

        <!-- 保存先が DB のときだけ (入力欄は、コードビハインドで入れる) -->
        <ContentPresenter
            x:Name="ConnectionHost"
            MaxWidth="480"
            HorizontalAlignment="Left"
            Visibility="{x:Bind ViewModel.IsSqlServer, Mode=OneWay}" />

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="変更は次の起動から反映されます。" />

        <Button
            MinWidth="96"
            Command="{x:Bind ViewModel.SaveCommand}"
            Content="保存"
            IsEnabled="{x:Bind ViewModel.IsEditable}"
            Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</UserControl>
