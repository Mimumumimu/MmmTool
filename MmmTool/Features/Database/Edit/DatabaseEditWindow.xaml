<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Features.Database.Edit.DatabaseEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="保存先">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="保存先" />
        </Grid>

        <!-- 選択と入力欄 -->
        <StackPanel
            Grid.Row="1"
            Padding="24,16,24,0"
            Spacing="12">

            <!-- 保存・接続の確認の結果 (閉じている間は、Spacing の分の場所も取らない) -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.Connection.Error.IsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Connection.Error.Message, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.Connection.Error.IsOpen, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.Connection.Success.IsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Connection.Success.Message, Mode=OneWay}"
                Severity="Success"
                Visibility="{x:Bind ViewModel.Connection.Success.IsOpen, Mode=OneWay}" />

            <RadioButton
                Content="ローカル (すべてこの PC に保存する)"
                GroupName="SaveTarget"
                IsChecked="{x:Bind ViewModel.IsLocal, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsEditable}" />
            <RadioButton
                Content="DB (一部のデータをサーバーに保存する)"
                GroupName="SaveTarget"
                IsChecked="{x:Bind ViewModel.IsSqlServer, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.IsEditable}" />

            <!-- DB を選んだときだけ (入力欄は、コードビハインドで入れる) -->
            <ContentPresenter x:Name="ConnectionHost" Visibility="{x:Bind ViewModel.IsSqlServer, Mode=OneWay}" />

            <!-- 「保存」を押せない理由 (DB を選んでいて、つながると確認できていないとき) -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="「接続を確認」で、つながることを確かめると、保存できます。"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.NeedsVerification, Mode=OneWay}" />
        </StackPanel>

        <!-- 操作ボタン (肯定を左・キャンセルを右に) -->
        <StackPanel
            Grid.Row="2"
            Padding="24,24,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="保存"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="閉じる" />
        </StackPanel>
    </Grid>
</Window>
