<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Features.Database.Choice.DatabaseChoiceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="保存先の選択">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="保存先の選択" />
        </Grid>

        <!-- 選択と入力欄 -->
        <StackPanel
            Grid.Row="1"
            Padding="24,16,24,0"
            Spacing="12">

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="リマインダーなどを保存する場所を選びます。あとから設定ページで変えられます。"
                TextWrapping="Wrap" />

            <!-- 選んだ内容の保存・接続の確認の結果 (閉じている間は、Spacing の分の場所も取らない) -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.Connection.Error.IsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Connection.Error.Message, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.Connection.Error.IsOpen, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.Connection.Success.IsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Connection.Success.Message, Mode=OneWay}"
                Severity="Success"
                Visibility="{x:Bind ViewModel.Connection.Success.IsOpen, Mode=OneWay}" />

            <StackPanel Spacing="2">
                <RadioButton
                    Content="ローカル (この PC だけで使う)"
                    GroupName="SaveTarget"
                    IsChecked="{x:Bind ViewModel.IsLocal, Mode=OneWay}" />
                <TextBlock
                    Margin="28,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="データは、この PC のファイルに保存します。" />
            </StackPanel>

            <StackPanel Spacing="2">
                <RadioButton
                    Content="DB (複数の PC で共有する)"
                    GroupName="SaveTarget"
                    IsChecked="{x:Bind ViewModel.IsSqlServer, Mode=TwoWay}" />
                <TextBlock
                    Margin="28,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="SQL Server に保存して、複数の PC でリマインダーを共有します。" />
            </StackPanel>

            <!-- DB を選んだときだけ (入力欄は、コードビハインドで入れる) -->
            <ContentPresenter x:Name="ConnectionHost" Visibility="{x:Bind ViewModel.IsSqlServer, Mode=OneWay}" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="選んだ内容は、次の起動から反映されます。" />
        </StackPanel>

        <!-- 操作ボタン -->
        <StackPanel
            Grid.Row="2"
            Padding="24,24,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.DecideCommand}"
                Content="決定"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
