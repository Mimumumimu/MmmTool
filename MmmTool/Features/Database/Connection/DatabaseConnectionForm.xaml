<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Features.Database.Connection.DatabaseConnectionForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <!-- 入力欄 (設定ファイルを読めなかったときは変更させない) -->
        <StackPanel IsEnabled="{x:Bind ViewModel.IsEditable}" Spacing="12">
            <TextBox
                GotFocus="OnAsciiBoxGotFocus"
                Header="サーバー名"
                Text="{x:Bind ViewModel.Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                GotFocus="OnAsciiBoxGotFocus"
                Header="データベース名"
                Text="{x:Bind ViewModel.DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Name"
                Header="ログインの方式"
                ItemsSource="{x:Bind ViewModel.Authentications}"
                SelectedItem="{x:Bind ViewModel.SelectedAuthentication, Mode=TwoWay}" />

            <!-- ユーザー名とパスワードのログインのときだけ -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsSqlLogin, Mode=OneWay}">
                <TextBox
                    GotFocus="OnAsciiBoxGotFocus"
                    Header="ユーザー名"
                    Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox
                    GotFocus="OnAsciiBoxGotFocus"
                    Header="{x:Bind ViewModel.PasswordHeader, Mode=OneWay}"
                    Password="{x:Bind ViewModel.Password, Mode=OneWay}"
                    PasswordChanged="OnPasswordChanged" />
            </StackPanel>

            <ToggleSwitch
                Header="サーバーの証明書を信頼する"
                IsOn="{x:Bind ViewModel.TrustServerCertificate, Mode=TwoWay}"
                OffContent="オフ"
                OnContent="オン" />
        </StackPanel>

        <Button
            MinWidth="96"
            Command="{x:Bind ViewModel.TestCommand}"
            Content="接続を確認"
            IsEnabled="{x:Bind ViewModel.IsNotTesting, Mode=OneWay}" />
    </StackPanel>
</UserControl>
