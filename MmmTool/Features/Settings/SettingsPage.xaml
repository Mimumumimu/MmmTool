<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

        <!-- 設定項目のリスト。項目が増えたらここへ縦に足す -->
        <StackPanel Grid.Row="1" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock VerticalAlignment="Center" Text="リマインダーのスヌーズ間隔（分）" />
                <NumberBox
                    Width="160"
                    GotFocus="OnNumberBoxGotFocus"
                    Loaded="OnNumberBoxLoaded"
                    LargeChange="10"
                    Maximum="{x:Bind ViewModel.SnoozeIntervalMax}"
                    Minimum="{x:Bind ViewModel.SnoozeIntervalMin}"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.SnoozeIntervalMinutes, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
