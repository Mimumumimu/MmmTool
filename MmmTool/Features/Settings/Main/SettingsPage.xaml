<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.Features.Settings.Main.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:MmmTool.Features.Settings.Main">

    <Grid Padding="24,16,0,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

        <!-- 項目が画面に収まらないときは縦にスクロールする。スクロールバーが右端に来るよう、右の余白はスクロールの外側の中身に付ける -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,24,24" Spacing="4">
                <!-- 設定ファイルを読めなかったとき (変更は保存できない)。閉じている間は、Spacing の分の場所も取らない -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />

                <!-- 機能のオン・オフ (オフにできる機能だけ。切り替えはすぐ反映する) -->
                <TextBlock Margin="1,12,0,4" Style="{StaticResource SettingsSectionHeaderStyle}" Text="機能" />
                <ItemsControl IsEnabled="{x:Bind ViewModel.IsEditable}" ItemsSource="{x:Bind ViewModel.Features}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:FeatureItem">
                            <controls:SettingsCard Header="{x:Bind DisplayName}">
                                <ToggleSwitch
                                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                    OffContent="オフ"
                                    OnContent="オン"
                                    Toggled="OnFeatureToggled" />
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 設定項目。各機能が登録した部品を、登録順に縦に並べる (コードビハインドで足す)。各部品が、自分の見出しとカードを持つ -->
                <StackPanel x:Name="SectionsPanel" Spacing="4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
