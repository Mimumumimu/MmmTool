<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.Features.Settings.Main.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />

        <StackPanel Grid.Row="1" Spacing="12">
            <!-- 設定ファイルを読めなかったとき（変更は保存できない） -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
                Severity="Error" />
            <!-- 設定項目。各機能が登録した部品を、登録順に縦に並べる（コードビハインドで足す） -->
            <StackPanel x:Name="SectionsPanel" Spacing="12" />
        </StackPanel>
    </Grid>
</Page>
