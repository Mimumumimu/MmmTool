<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Features.Users.SignIn.SignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Features.Users.SignIn"
    Title="ログイン">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Heading, Mode=OneWay}" />
        </Grid>

        <!-- 入力欄 -->
        <StackPanel
            Grid.Row="1"
            Padding="24,16,24,0"
            Spacing="12">

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="管理者がパスワードを再設定しました。"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsNewPasswordMode, Mode=OneWay}" />

            <TextBox
                x:Name="LoginNameBox"
                Header="ログイン名"
                IsEnabled="{x:Bind ViewModel.IsLoginNameEditable, Mode=OneWay}"
                MaxLength="{x:Bind ViewModel.LoginNameMaxLength}"
                Text="{x:Bind ViewModel.LoginName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                x:Name="DisplayNameBox"
                GotFocus="OnDisplayNameBoxGotFocus"
                Header="表示名"
                MaxLength="{x:Bind ViewModel.DisplayNameMaxLength}"
                Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsRegisterMode, Mode=OneWay}" />

            <PasswordBox
                x:Name="PasswordBox"
                Header="パスワード"
                Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <PasswordBox
                Header="パスワード (確認)"
                Password="{x:Bind ViewModel.PasswordConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind local:SignInWindow.IsConfirmVisible(ViewModel.Mode), Mode=OneWay}" />

            <!-- エラー。行は場所を空けておく (出たり消えたりで下が動かないように) -->
            <TextBlock
                MinHeight="16"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 操作ボタン。主な操作だけを強調し、副の操作は文字だけのボタンにする -->
        <Grid Grid.Row="2" Padding="24,12,24,24">
            <Button
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.SecondaryCommand}"
                Content="{x:Bind ViewModel.SecondaryText, Mode=OneWay}"
                Style="{StaticResource TextBlockButtonStyle}"
                Visibility="{x:Bind ViewModel.HasSecondary, Mode=OneWay}" />
            <Button
                MinWidth="96"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.SubmitCommand}"
                Content="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- 保存先 (DB)の失敗。レイアウトに場所を取らず、入力欄の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.SaveError.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SaveError.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
