<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Features.Users.Registration.UserRegistrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Features.Users.Registration"
    Title="ユーザーの登録">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル帯 (ドラッグで移動できる)。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="ユーザーの登録" />
        </Grid>

        <!-- 入力欄 -->
        <StackPanel
            Grid.Row="1"
            Padding="24,16,24,0"
            Spacing="12">

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="このアプリを使う人として、この PC を登録します。"
                TextWrapping="Wrap" />

            <!-- 表示名。エラーの行は場所を空けておく (出たり消えたりで下の欄が動かないように) -->
            <StackPanel Spacing="4">
                <TextBox
                    x:Name="NameBox"
                    GotFocus="OnNameBoxGotFocus"
                    Header="表示名"
                    MaxLength="{x:Bind ViewModel.DisplayNameMaxLength}"
                    Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    MinHeight="16"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.NameError, Mode=OneWay}" />
            </StackPanel>

            <!-- この PC の MAC アドレス。1 つなら表示だけ、複数なら選ぶ -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasSingleMacAddress}">
                <TextBlock Text="この PC (MAC アドレス)" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.SelectedMacAddress.Display, Mode=OneWay}" />
            </StackPanel>
            <ComboBox
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Display"
                Header="この PC (MAC アドレス)"
                ItemsSource="{x:Bind ViewModel.MacAddresses}"
                SelectedItem="{x:Bind ViewModel.SelectedMacAddress, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasMultipleMacAddresses}" />
        </StackPanel>

        <!-- 操作ボタン (Windows の流儀で、肯定を左・キャンセルを右に) -->
        <StackPanel
            Grid.Row="2"
            Padding="24,24,24,24"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.RegisterCommand}"
                Content="登録"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!-- 登録のエラー。レイアウトに場所を取らず、入力欄の上部に重ねる -->
        <InfoBar
            Grid.Row="1"
            Margin="16,0"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.SaveError.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.SaveError.Message, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
