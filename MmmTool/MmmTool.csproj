<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MmmTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- ランタイム（Windows App Runtime / .NET）は PC 側にインストールする前提。出力ファイル数を減らすため -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <!-- 言語別リソース（NuGet 由来のサテライト DLL）を日本語・英語だけにする -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <!-- アプリのアイコン（EXE に埋め込むほか、トレイ・ウィンドウのアイコンとして実行時にファイルから読む） -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- ターミナル描画（xterm.js、MIT）。WebView2 から読み込むため出力フォルダへコピーする -->
    <Content Include="Assets\Terminal\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- ターミナルの定型コマンドから呼ぶ補助スクリプト（{AppDir}\Assets\Tools\...）。出力フォルダへコピーする -->
    <Content Include="Assets\Tools\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MmmTool.Core\MmmTool.Core.csproj" />
    <ProjectReference Include="..\external\MmmSdk\MmmSdk.WinUI\MmmSdk.WinUI.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Windows App SDK が出力へコピーする WinUI の多言語リソース（言語名フォルダ内の .mui）のうち、
    日本語・英語以外を削除する。SatelliteResourceLanguages では消えないため。
  -->
  <Target Name="PruneMuiAfterBuild" AfterTargets="Build">
    <ItemGroup>
      <_MuiBuild Include="$(OutDir)*\*.mui" Exclude="$(OutDir)ja-JP\*.mui;$(OutDir)en-us\*.mui" />
      <_MuiBuildDir Include="@(_MuiBuild->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Delete Files="@(_MuiBuild)" />
    <RemoveDir Directories="@(_MuiBuildDir-&gt;Distinct())" />
  </Target>
  <Target Name="PruneMuiAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <_MuiPub Include="$(PublishDir)*\*.mui" Exclude="$(PublishDir)ja-JP\*.mui;$(PublishDir)en-us\*.mui" />
      <_MuiPubDir Include="@(_MuiPub->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Delete Files="@(_MuiPub)" />
    <RemoveDir Directories="@(_MuiPubDir-&gt;Distinct())" />
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- トリミングは自己完結のときだけ使える。フレームワーク依存なので無効 -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>