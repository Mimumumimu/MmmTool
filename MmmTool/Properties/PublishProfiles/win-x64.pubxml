<?xml version="1.0" encoding="utf-8"?>
<!--
発行プロファイル。VS の「発行」と、コマンドの dotnet publish .\MmmTool\MmmTool.csproj -p:PublishProfile=win-x64 の両方で使う
（構成・プラットフォーム・出力先だけを書く。発行の設定の本体は csproj の Publish Properties）
出力先は、版を含まない途中のフォルダ（obj\Release\publish\）。配布物（bin\Release\publish\MmmTool_<版>\）は、発行のあとに csproj の PackageDistribution が作る。
VS の「発行」はこのファイルを単体で読むので、プロジェクトの Version は使えない。また、VS は Import などを書いたプロファイルを読めない（プロパティだけを書く）
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>obj\$(Configuration)\publish\</PublishDir>
  </PropertyGroup>
</Project>
