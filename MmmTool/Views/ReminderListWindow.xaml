<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Views.ReminderListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Views"
    xmlns:vm="using:MmmTool.ViewModels"
    Title="リマインダー一覧">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- 列の幅（見出しと行で共通）。日付 / 曜日 / 時刻 / 件名（残り全部） -->
            <GridLength x:Key="DateColumnWidth">120</GridLength>
            <GridLength x:Key="WeekdayColumnWidth">120</GridLength>
            <GridLength x:Key="TimeColumnWidth">80</GridLength>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル帯（ドラッグで移動できる）。右上の × と重ならないよう右に余白を空ける -->
        <Grid
            x:Name="TitleBarArea"
            Grid.Row="0"
            Height="56"
            Padding="24,0,48,0">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="リマインダー一覧" />
        </Grid>

        <!-- 操作 -->
        <Grid Grid.Row="1" Padding="24,16,24,12">
            <Button
                MinWidth="96"
                Command="{x:Bind ViewModel.AddCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="新規追加" />
                </StackPanel>
            </Button>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="24">
                <ToggleSwitch
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.ShowPast, Mode=TwoWay}"
                    OffContent="過去の予定を表示"
                    OnContent="過去の予定を表示" />
                <ToggleSwitch
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.ShowDeleted, Mode=TwoWay}"
                    OffContent="削除済みを表示"
                    OnContent="削除済みを表示" />
            </StackPanel>
        </Grid>

        <!-- 一覧（見出しは固定で、行だけスクロール） -->
        <Grid
            Grid.Row="2"
            Margin="24,0,24,24"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 見出し。左右の余白は行（ListViewItem の外側 4 + 内側 12）に合わせる -->
            <Grid
                Grid.Row="0"
                Padding="16,10,16,10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource DateColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource WeekdayColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource TimeColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="日付" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="曜日" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="時刻" />
                <TextBlock
                    Grid.Column="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="件名" />
            </Grid>

            <ListView
                x:Name="ReminderList"
                Grid.Row="1"
                Padding="0,4"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReminderListItem">
                        <!-- 行全体でダブルタップ・右クリックを受けるため、背景を透明で塗る -->
                        <Grid
                            Background="Transparent"
                            DoubleTapped="OnRowDoubleTapped"
                            Opacity="{x:Bind local:ReminderListWindow.RowOpacity(IsDeleted)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource DateColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource WeekdayColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource TimeColumnWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnEditClick"
                                        Icon="Edit"
                                        Tag="{x:Bind}"
                                        Text="編集" />
                                    <MenuFlyoutItem
                                        Click="OnCopyAsNewClick"
                                        Icon="Copy"
                                        Tag="{x:Bind}"
                                        Text="コピーして新規追加" />
                                    <!-- 削除済みでない行は「削除」、削除済みの行は「完全削除」 -->
                                    <MenuFlyoutItem
                                        Click="OnDeleteClick"
                                        Icon="Delete"
                                        Tag="{x:Bind}"
                                        Text="削除"
                                        Visibility="{x:Bind local:ReminderListWindow.VisibleUnless(IsDeleted)}" />
                                    <MenuFlyoutItem
                                        Click="OnPurgeClick"
                                        Icon="Delete"
                                        Tag="{x:Bind}"
                                        Text="完全削除"
                                        Visibility="{x:Bind IsDeleted}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{x:Bind DateText}"
                                TextDecorations="{x:Bind local:ReminderListWindow.Strike(IsDeleted)}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind WeekdayText}"
                                TextDecorations="{x:Bind local:ReminderListWindow.Strike(IsDeleted)}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind TimeText}"
                                TextDecorations="{x:Bind local:ReminderListWindow.Strike(IsDeleted)}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Text="{x:Bind Title}"
                                TextDecorations="{x:Bind local:ReminderListWindow.Strike(IsDeleted)}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- エラー。レイアウトに場所を取らず、一覧の上部に重ねる -->
        <InfoBar
            Grid.Row="2"
            Margin="32,8,32,0"
            VerticalAlignment="Top"
            CloseButtonClick="OnErrorCloseClick"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
