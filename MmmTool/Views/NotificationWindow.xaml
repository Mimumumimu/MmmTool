<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MmmTool.Views.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MmmTool">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- 到達の明滅：不透明度 0 → 0.55（0.09 秒）→ 0（0.18 秒）を 3 回 -->
            <Storyboard x:Name="BlinkStoryboard" RepeatBehavior="3x">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlinkOverlay" Storyboard.TargetProperty="Opacity">
                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.09" Value="0.55" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.27" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>

        <Grid Padding="16,8,16,16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 右上のウィンドウボタンと重ならないよう、右に余白を空ける -->
            <TextBlock
                Grid.Row="0"
                Margin="0,4,120,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>

        <!-- 到達時の明滅用。操作を邪魔しないよう当たり判定を持たせない。既定は透明 -->
        <Border
            x:Name="BlinkOverlay"
            Background="#FFFFB300"
            IsHitTestVisible="False"
            Opacity="0" />
    </Grid>
</Window>
