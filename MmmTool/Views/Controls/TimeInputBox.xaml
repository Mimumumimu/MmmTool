<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Views.Controls.TimeInputBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left">

    <UserControl.Resources>
        <!-- 区画（時・分）の入力欄。枠・背景・消去ボタンを持たない最小のテンプレート（見た目は外側の枠が受け持つ） -->
        <Style x:Key="SegmentBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="2" />
            <Setter Property="InputScope" Value="Number" />
            <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
            <Setter Property="SelectionHighlightColor" Value="{ThemeResource TextControlSelectionHighlightColor}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            AutomationProperties.AccessibilityView="Raw"
                            HorizontalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Disabled"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled"
                            ZoomMode="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 外側の枠（標準の入力欄と同じ見た目。フォーカス中は下線をアクセント色で太く） -->
    <Grid
        x:Name="Frame"
        MinHeight="{ThemeResource TextControlThemeMinHeight}"
        Padding="12,0"
        Background="{ThemeResource TextControlBackground}"
        BorderBrush="{ThemeResource TextControlElevationBorderBrush}"
        BorderThickness="{ThemeResource TextControlBorderThemeThickness}"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        PointerEntered="OnFramePointerEntered"
        PointerExited="OnFramePointerExited"
        Tapped="OnFrameTapped">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBox
                x:Name="HourBox"
                AutomationProperties.Name="時"
                Style="{StaticResource SegmentBoxStyle}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text=":" />
            <TextBox
                x:Name="MinuteBox"
                AutomationProperties.Name="分"
                Style="{StaticResource SegmentBoxStyle}" />
        </StackPanel>

        <!-- フォーカス中の下線 -->
        <Border
            x:Name="FocusLine"
            Height="2"
            Margin="-12,0"
            VerticalAlignment="Bottom"
            Background="{ThemeResource TextControlBorderBrushFocused}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
