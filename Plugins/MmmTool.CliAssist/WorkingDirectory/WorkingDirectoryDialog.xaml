<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MmmTool.CliAssist.WorkingDirectory.WorkingDirectoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="作業ディレクトリ変更"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}"
    PrimaryButtonText="変更"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid Width="480" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="フォルダを入力するか、最近使ったフォルダから選んでください。"
            TextWrapping="Wrap" />

        <!-- パス入力 + 参照 -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                PlaceholderText="C:\work\project"
                Text="{x:Bind ViewModel.DirectoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="フォルダを参照"
                Command="{x:Bind ViewModel.BrowseCommand}"
                ToolTipService.ToolTip="フォルダを参照">
                <FontIcon FontSize="16" Glyph="&#xE838;" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="フォルダが見つかりません"
                Visibility="{x:Bind ViewModel.IsNotFound, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="ほかのタブで開いているフォルダです"
                Visibility="{x:Bind ViewModel.IsOpenInOtherSession, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            Margin="0,8,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="最近使ったフォルダ" />

        <!-- 履歴 (クリックで入力、ダブルクリックでそのまま変更、× で削除) -->
        <Grid Grid.Row="4">
            <ListView
                MaxHeight="260"
                DoubleTapped="OnDirectoryDoubleTapped"
                IsItemClickEnabled="True"
                ItemClick="OnDirectoryClick"
                ItemsSource="{x:Bind ViewModel.Directories}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8B7;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind}" />
                            <Button
                                Grid.Column="2"
                                Padding="6"
                                AutomationProperties.Name="履歴から削除"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRemoveDirectoryClick"
                                ToolTipService.ToolTip="履歴から削除">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Margin="0,8"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="まだありません。選んだフォルダが、ここに追加されます。"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoDirectories, Mode=OneWay}" />
        </Grid>

        <TextBlock
            Grid.Row="5"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />
    </Grid>
</ContentDialog>
