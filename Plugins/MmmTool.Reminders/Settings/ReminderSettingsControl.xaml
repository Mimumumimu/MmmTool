<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MmmTool.Reminders.Settings.ReminderSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="4">
        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="リマインダー" />

        <!-- 保存に失敗したとき (閉じている間は、Spacing の分の場所も取らない) -->
        <InfoBar
            IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.Error.IsOpen, Mode=OneWay}" />

        <controls:SettingsCard Description="通知を先送りする時間 (分)" Header="スヌーズ間隔">
            <NumberBox
                Width="160"
                GotFocus="OnNumberBoxGotFocus"
                IsEnabled="{x:Bind ViewModel.IsEditable}"
                Loaded="OnNumberBoxLoaded"
                LargeChange="10"
                Maximum="{x:Bind ViewModel.SnoozeIntervalMax}"
                Minimum="{x:Bind ViewModel.SnoozeIntervalMin}"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.SnoozeIntervalMinutes, Mode=TwoWay}" />
        </controls:SettingsCard>

        <!-- 読み上げの声と速さは Windows の音声の設定に従う。外へ出るだけなので、強調しないリンク型にする -->
        <controls:SettingsCard Description="Windows の音声設定に従います" Header="読み上げの声・速さ">
            <HyperlinkButton Command="{x:Bind ViewModel.OpenSpeechSettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="開く" />
                    <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="&#xE8A7;" />
                </StackPanel>
            </HyperlinkButton>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
