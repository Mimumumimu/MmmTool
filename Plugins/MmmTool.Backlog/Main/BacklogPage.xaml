<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MmmTool.Backlog.Main.BacklogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MmmTool.Backlog.Main">

    <Page.Resources>
        <!-- カード (リンク・クリップボード転送のページと同じ) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- 一覧の行を、横いっぱいに広げる -->
        <Style x:Key="FileRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Backlog" />

        <!-- 進行・結果・エラー (操作のたびに、前の分は消える) -->
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsResultOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                Severity="Success"
                Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.Error.IsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Error.Message, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>

        <!-- 連携用パスと操作。主な操作は「一覧取得」だけを強調する -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <TextBox
                    Header="連携用パス (URL)"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="https://スペース名.backlog.jp/file/プロジェクトキー/フォルダー"
                    Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.FetchCommand}"
                        Content="一覧取得"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Command="{x:Bind ViewModel.OpenInBrowserCommand}" Content="ブラウザで開く" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 共有ファイルの一覧 -->
        <Border Grid.Row="3" Padding="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Padding="20,16,20,8"
                    Spacing="2"
                    Visibility="{x:Bind ViewModel.HasFetched, Mode=OneWay}">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource FileRowStyle}"
                    ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BacklogFileItem">
                            <Grid Padding="0,6" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8A5;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="72"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind SizeText}"
                                    TextAlignment="Right" />
                                <TextBlock
                                    Grid.Column="3"
                                    MinWidth="120"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind UpdatedText}" />
                                <Button
                                    Grid.Column="4"
                                    Command="{x:Bind DownloadCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="ダウンロード" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 一覧が空のとき (まだ取得していない・ファイルが無い) -->
                <TextBlock
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="一覧取得を押すと、ファイルが表示されます。"
                    Visibility="{x:Bind ViewModel.IsPlaceholderVisible, Mode=OneWay}" />
                <TextBlock
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="このフォルダーにファイルはありません。"
                    Visibility="{x:Bind ViewModel.IsEmptyVisible, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
